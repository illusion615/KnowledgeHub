<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="BRK285 自主排障参考架构（低代码推理 + 全代码持久控制）"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-case-and-trigger" value="1. 客户工单记录系统与受管事件触发面（Dynamics 365 FACS &amp; Power Platform）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1440" height="190" as="geometry"/></mxCell><mxCell id="group-reasoning-and-mcp" value="2. 低代码多专员协同推理与模型上下文协议工具桥（Copilot Studio &amp; MCP）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="238" width="1440" height="190" as="geometry"/></mxCell><mxCell id="group-procode-and-ops" value="3. 全代码持久状态机、发布质量门禁与爬山优化底座（Azure &amp; Foundry）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="452" width="1440" height="190" as="geometry"/></mxCell><mxCell id="d365-facs" value="&lt;b&gt;Dynamics 365 客户服务（FACS）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;工单唯一事实源；承接客户回复、自主结案与升级人工坐席&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="power-automate" value="&lt;b&gt;Power Automate 与受管连接器&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;监听新建工单与跨天追问事件，将 MCP 服务挂载为受控工具&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="managed-env" value="&lt;b&gt;受管环境防泄漏与最小权限&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;隔离租户数据边界、隐私脱敏与角色权限，拦截越权外发&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="orchestrator" value="&lt;b&gt;Copilot Studio 主控与六专员智能体&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;协同调度意图识别、证据合成、追问澄清、领域专家与回复起草&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="quality-critic" value="&lt;b&gt;内置质量审校门禁（Quality Critic）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;在回复客户前核验证据强度与安全合规；工具超时自动触发升级兜底&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="mcp-bridge" value="&lt;b&gt;四路 MCP 工具桥（经 APIM 网关）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;统一接入工单历史、排障状态、Microsoft Learn 官方文档与线上诊断遥测&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="durable-state" value="&lt;b&gt;Azure Durable Functions + Cosmos DB&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;跨数天至数周持久化单案状态、证据链、审计账本与可测决策逻辑&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="foundry-gates" value="&lt;b&gt;Microsoft Foundry 评测与发布门禁&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;结合专家评分量表、基准测试集与历史重放，执行金丝雀分阶段放量&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="telemetry-fabric" value="&lt;b&gt;Azure Monitor + ADX + Fabric 看板&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;采集逐轮执行追踪与跨团队归属日志，驱动失败分桶与爬山迭代&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="edge-1" value="派发工单" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d365-facs" target="orchestrator"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-2" value="事件唤醒" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="power-automate" target="quality-critic"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-3" value="策略约束" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="managed-env" target="mcp-bridge"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-4" value="读写单案状态" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="orchestrator" target="durable-state"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-5" value="量表校验" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="quality-critic" target="foundry-gates"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-6" value="汇聚追踪" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mcp-bridge" target="telemetry-fabric"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
