<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="企业级业务流程三位一体与合作伙伴全生命周期变现闭环（BRK501 架构全景）"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-authoring-plane" value="1. 全入口协作构建与迁移层（Cowork 自然语言 · Studio 低代码 · MCP 专业开发）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1400" height="190" as="geometry"/></mxCell><mxCell id="group-trinity-plane" value="2. 组织级业务流程三位一体执行底座（Copilot Studio + Power Platform）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="1400" height="190" as="geometry"/></mxCell><mxCell id="group-partner-plane" value="3. 合作伙伴持续运营与商业增长飞轮（Frontier Accelerate + ASPX + AgentOps）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="456" width="1400" height="190" as="geometry"/></mxCell><mxCell id="cowork-nl" value="&lt;b&gt;Copilot Cowork 自然语言构建&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;业务人员加载 Studio 插件，30 分钟/$20 生成三位一体方案并支持旧内核迁移&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="79" y="94" width="420" height="96" as="geometry"/></mxCell><mxCell id="studio-designers" value="&lt;b&gt;Copilot Studio 极简设计器&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;流程负责人零代码编排上下/左右双向视图、内置 Evals 评测与多创作者共建&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="530" y="94" width="420" height="96" as="geometry"/></mxCell><mxCell id="mcp-cli" value="&lt;b&gt;Copilot Studio CLI 与 MCP 工具链&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;合作伙伴工程师在 IDE 内开发自研连接器与可复用 IP，发布移交客户业务方&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="981" y="94" width="420" height="96" as="geometry"/></mxCell><mxCell id="agents-runtime" value="&lt;b&gt;Agents：推理决策与专属员工账号&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Microsoft Copilot Harness (+22 pts / 省 15-21% 净输入) + 独立 Entra/邮箱/Teams&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="79" y="310" width="420" height="96" as="geometry"/></mxCell><mxCell id="workflows-det" value="&lt;b&gt;Workflows：确定性一致执行与审批&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;无需大模型介入的重复流转走低成本确定性自动化，支持按场景分离委托凭据&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="530" y="310" width="420" height="96" as="geometry"/></mxCell><mxCell id="apps-runtime" value="&lt;b&gt;Apps：托管运行时结构化交互（GA）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Copilot Managed Runtime 承载可视化看板，关联 SharePoint / Dataverse 记录系统&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="981" y="310" width="420" height="96" as="geometry"/></mxCell><mxCell id="frontier-accel" value="&lt;b&gt;Frontier Accelerate 三阶加速包&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;售前 Envisioning &amp;amp; PoC 立项 + 售后 Copilot 与 Agent Solution 双部署加速器&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="79" y="526" width="420" height="96" as="geometry"/></mxCell><mxCell id="aspx-cosell" value="&lt;b&gt;ASPX 活跃消耗看板与联合销售&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;追踪席位采纳率（如 50% 激活缺口）、点数消耗与加购倾向，驱动增购续约&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="530" y="526" width="420" height="96" as="geometry"/></mxCell><mxCell id="finops-agentops" value="&lt;b&gt;AI FinOps 与常驻托管服务（$16.45）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;MAC/PPAC 成本护栏、Agent 365 治理与嵌入式持续迭代（+152% 开发 / +125% 托管）&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="981" y="526" width="420" height="96" as="geometry"/></mxCell><mxCell id="edge-1" value="生成指令与账号" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cowork-nl" target="agents-runtime"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-2" value="生成托管界面" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cowork-nl" target="apps-runtime"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-3" value="低代码编排" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="studio-designers" target="workflows-det"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-4" value="注入可复用 IP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mcp-cli" target="agents-runtime"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-5" value="触发分派与写库" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="agents-runtime" target="workflows-det"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-6" value="同步业务台账" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="workflows-det" target="apps-runtime"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-7" value="点数账本与监控" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="agents-runtime" target="finops-agentops"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-8" value="消耗与倾向信号" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="workflows-det" target="aspx-cosell"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-9" value="规模化采纳闭环" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="apps-runtime" target="frontier-accel"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
