<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="Microsoft Ignite 2026：Copilot Studio 三支柱与双运行时全景架构"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-entry-plane" value="1. 自然语言与代码优先统一创作面（Unified Maker &amp; Agentic CLI Entry）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1440" height="186" as="geometry"/></mxCell><mxCell id="group-trinity-plane" value="2. 业务流程三位一体资产与三轨 Harness（Agents + Workflows + Apps）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="234" width="1440" height="186" as="geometry"/></mxCell><mxCell id="group-gov-plane" value="3. 持久身份、跨系统连接与百万级规模治理（Identity, MCP/A2A &amp; FinOps）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="444" width="1440" height="186" as="geometry"/></mxCell><mxCell id="cowork-code" value="&lt;b&gt;Copilot Cowork &amp;amp; Copilot Code&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;自然语言描述业务目标，AI 自动拆解智能体/工作流/应用架构（Preview）&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="94" width="320" height="92" as="geometry"/></mxCell><mxCell id="studio-designers" value="&lt;b&gt;全新极简设计器（New Designers）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;单屏行内配置模型、工具、技能、知识与记忆；工作流支持横纵一键切换&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="94" width="320" height="92" as="geometry"/></mxCell><mxCell id="mcp-cli" value="&lt;b&gt;Copilot Studio MCP &amp;amp; 双轨 CLI&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;VS Code / GitHub Copilot / Claude Code 直连创建、评测与迁移&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="94" width="320" height="92" as="geometry"/></mxCell><mxCell id="copilot-harness" value="&lt;b&gt;三轨智能体编排（Copilot / Customer / Standard）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;安全容器长程自恢复推理 + 全渠道语音/网页客服转人工 + 经典兼容&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="304" width="320" height="92" as="geometry"/></mxCell><mxCell id="ai-workflows" value="&lt;b&gt;确定性工作流 + 智能节点（Workflows）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;审批与合规走确定性轨道；按需嵌入 Agent / Classify / Extract / Copilot 节点&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="304" width="320" height="92" as="geometry"/></mxCell><mxCell id="managed-apps" value="&lt;b&gt;全栈托管微应用（Apps on CMR）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;对话生成交互界面并保留源码访问；自动沙盒托管与 MCP Apps 聊天内嵌组件&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="304" width="320" height="92" as="geometry"/></mxCell><mxCell id="agent-identity" value="&lt;b&gt;Entra 独立账号 · Work IQ · 持久记忆&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;专属邮箱与 Teams 在线身份 + 事件触发器 + 默认挂载组织实时上下文&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="514" width="320" height="92" as="geometry"/></mxCell><mxCell id="mcp-a2a" value="&lt;b&gt;组织级 Skills 目录与 MCP / A2A 互联&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Markdown 技能全组织共享；双向连接 Foundry、Agents SDK 与外部智能体&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="514" width="320" height="92" as="geometry"/></mxCell><mxCell id="evals-finops" value="&lt;b&gt;Evals 评测 · Monitor 监控 · FinOps 账本&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;多模型质量/成本并排对比、上线告警、级联额度预算与 Purview 合规留痕&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="514" width="320" height="92" as="geometry"/></mxCell><mxCell id="edge-1" value="生成智能体" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cowork-code" target="copilot-harness"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-2" value="编排流程" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="studio-designers" target="ai-workflows"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-3" value="构建与发布" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mcp-cli" target="managed-apps"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-4" value="持久执行" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="copilot-harness" target="agent-identity"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-5" value="调用工具与技能" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ai-workflows" target="mcp-a2a"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-6" value="全量计量与治理" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="managed-apps" target="evals-finops"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
