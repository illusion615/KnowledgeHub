<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="Customer Conversation Harness 全渠道多智能体与联络中心协同架构（BRK379）"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-omnichannel-ingress" value="1. 原生全渠道接入与声纹身份防线（Omnichannel Ingress &amp; Voice Biometrics）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1440" height="190" as="geometry"/></mxCell><mxCell id="group-harness-orchestration" value="2. Customer Conversation Harness 多智能体混合推理层（Hybrid Orchestration）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="238" width="1440" height="190" as="geometry"/></mxCell><mxCell id="group-iq-cci-governance" value="3. 企业语境底座、人工联络中心无缝交接与 Agent 365 治理层（IQ · CCI · A365）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="452" width="1440" height="190" as="geometry"/></mxCell><mxCell id="digital-channels" value="&lt;b&gt;网页聊天与移动消息（Web &amp;amp; Messaging）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;一次编写渲染 Adaptive Card 富交互卡片，掉线重连跨渠道保留会话状态&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="voice-native" value="&lt;b&gt;Teams Phone 与语音原生管道&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;支持 Harper 多语种音色、Microsoft AI Realtime 1 模型、静默检测与随时打断&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="voice-biometrics" value="&lt;b&gt;声纹生物识别与反欺诈校验&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;约 3.3 秒完成声纹核验，拦截录音回放、Deepfake 合成语音与冒名拨打&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="primary-concierge" value="&lt;b&gt;主控接待智能体与跨通记忆&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;按意图动态路由请求，认证通过后拉取历史交互记忆，掉线重拨无缝续接&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="hybrid-subagents" value="&lt;b&gt;专职子智能体（生成式技能 + 确定性话题）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;同智能体内混编开放式 Generative Skills 与合规强制步骤 Topics 并互通变量&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="connected-foundry" value="&lt;b&gt;跨底座复用与 Foundry 外部智能体&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;直接挂载现有 Copilot Studio 工作流、CPU 精调小模型与 Azure AI Foundry 代理&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="microsoft-iq" value="&lt;b&gt;Microsoft IQ 三域统一业务语境&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;融合 Work IQ（政策邮件）、Foundry IQ（产品手册）与 Fabric IQ（订单账务）&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="cci-teams-handoff" value="&lt;b&gt;CCI 联络中心与 Teams 人工坐席交接&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;零改造保留 Avaya / Genesys / Five9 / Dynamics 或 Teams 队列，透传实时转录&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="a365-governance" value="&lt;b&gt;Agent 365 即时注册与会话质量评分&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;创建即登记 Entra ID 与 DLP 策略，后台自动完成自助分流会话质量评估&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="e1" value="富媒体与状态同步" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="digital-channels" target="primary-concierge"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="实时音频流校验" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="voice-native" target="voice-biometrics"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="认证通过唤醒记忆" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="voice-biometrics" target="primary-concierge"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="意图分发与变量注入" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="primary-concierge" target="hybrid-subagents"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="调用工作流/账务分析" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hybrid-subagents" target="connected-foundry"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="供给实时业务知识" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="microsoft-iq" target="hybrid-subagents"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="异常/未认证带摘要转人工" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="primary-concierge" target="cci-teams-handoff"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="质量评分与全周期审计" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cci-teams-handoff" target="a365-governance"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
