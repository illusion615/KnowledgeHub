<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="企业智能体三层治理与统一 FinOps 控制架构（BRK262）"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-maker-build-plane" value="1. 创作者赋能与环境边界层（Power Platform Admin Center + Copilot Studio）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1440" height="192" as="geometry"/></mxCell><mxCell id="group-runtime-security-plane" value="2. 全域可观测与安全合规防线（Agent 365 + Entra + Purview + Defender）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="1440" height="192" as="geometry"/></mxCell><mxCell id="group-finops-control-plane" value="3. 统一财务运营与花费策略控制面（M365 Admin Center + API Automation）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="456" width="1440" height="192" as="geometry"/></mxCell><mxCell id="ppac-env-routing" value="&lt;b&gt;环境路由与高级连接器策略&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;隔离个人开发与生产环境，管控外发连接器、病毒式链接传播（如 &amp;gt;10 人晋升）&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="94" width="320" height="98" as="geometry"/></mxCell><mxCell id="maker-credit-vis" value="&lt;b&gt;创作者实时点数与安全预警&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;预览窗实时显示消耗，按评测集拆解账单，Monitor 追踪计费并前置下沉安全告警&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="94" width="320" height="98" as="geometry"/></mxCell><mxCell id="pp-admin-plugin" value="&lt;b&gt;Admin 插件与 15 分钟托管看板&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;自然语言秒查 Top 10 环境；两页提示词调 Admin V2 连接器生成高管定制应用&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="94" width="320" height="98" as="geometry"/></mxCell><mxCell id="entra-purview-guard" value="&lt;b&gt;Entra 智能体身份与 Purview 合规&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;独立邮箱/日历身份与访问包决定左栏预装；敏感数据标签与合规审计日志基线&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="310" width="320" height="98" as="geometry"/></mxCell><mxCell id="a365-observability" value="&lt;b&gt;Agent 365 跨生态拓扑与 ROI 归因&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;统揽微软及 AWS/Salesforce/ServiceNow 智能体，按岗位时薪与耗时核算真实产出&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="310" width="320" height="98" as="geometry"/></mxCell><mxCell id="defender-runtime" value="&lt;b&gt;Defender 实时威胁检测与响应&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;汇聚 Defender、Purview 与 Entra 高中低风险告警，动态收紧工具与动作爆炸半径&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="310" width="320" height="98" as="geometry"/></mxCell><mxCell id="mac-spending-policy" value="&lt;b&gt;MAC 双维重叠花费策略（优先扣减）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;支持资源级（AskHR/环境）与身份级（安全组/个人），统一封顶预付包与 PayGo&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="526" width="320" height="98" as="geometry"/></mxCell><mxCell id="ppac-reporting-api" value="&lt;b&gt;PPAC Reporting API（四维日切片）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;公测开放 User × Agent × Feature × Day 细粒度拉取，揪出违规重模型与高耗连接器&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="526" width="320" height="98" as="geometry"/></mxCell><mxCell id="create-policy-api" value="&lt;b&gt;Create Policy API 智能体代建策略&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Excel + Markdown 驱动后台 PowerShell 秒建 20,000 点数限额策略并语音播报校验&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="526" width="320" height="98" as="geometry"/></mxCell><mxCell id="e1" value="注入身份与合规基线" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ppac-env-routing" target="entra-purview-guard"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="发布入网与价值追踪" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="maker-credit-vis" target="a365-observability"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="拉取全量资产与日耗" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pp-admin-plugin" target="ppac-reporting-api"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="映射用户组与资源域" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="entra-purview-guard" target="mac-spending-policy"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="按 ROI 调优预算限额" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="a365-observability" target="mac-spending-policy"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="下沉风险告警自愈" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="defender-runtime" target="maker-credit-vis"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="API 批量下发限额" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="create-policy-api" target="mac-spending-policy"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
