<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="从社区原型到企业级生产规模化的 Choose → Prove → Sustain 闭环架构（THR1022）"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-choose-intake-plane" value="1. CHOOSE · 断裂工作流征集与四项测试筛选层（Broken-Workflow Intake &amp; Four-Test Scorecard）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1440" height="192" as="geometry"/></mxCell><mxCell id="group-prove-value-plane" value="2. PROVE · 建前五问基线、回收率折算与四维价值引擎（Pre-Build Baseline &amp; Recapture ROI Engine）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="1440" height="192" as="geometry"/></mxCell><mxCell id="group-sustain-flywheel-plane" value="3. SUSTAIN · 采纳飞轮、M365 消费限额与退役治理（Adoption Flywheel &amp; M365 Admin Spend Control）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="456" width="1440" height="192" as="geometry"/></mxCell><mxCell id="broken-workflow-intake" value="&lt;b&gt;征集“断裂工作流”而非点子&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;黑客松与立项停征泛化智能体创意，锁定耗时数周或跨多工具受阻的真实团队痛点&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="94" width="320" height="98" as="geometry"/></mxCell><mxCell id="four-test-scorecard" value="&lt;b&gt;四项测试计分卡与决策者共审&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;联合业务决策者逐项核验：周频重复、锚定指标、人机交接提质、端到端零手工断尾&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="94" width="320" height="98" as="geometry"/></mxCell><mxCell id="portfolio-allocation" value="&lt;b&gt;组合配比与实名责任人绑定&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;优选 3–5 个速赢与 1–2 个阶段门禁战略项目；恪守“无责任人、无基线则不立项”&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="94" width="320" height="98" as="geometry"/></mxCell><mxCell id="five-prebuild-questions" value="&lt;b&gt;开工前五问与量化基线锁定&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;明确卡点环节、受影响角色、目标指标与期限、当前基线，以及扩缩或叫停评审人&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="310" width="320" height="98" as="geometry"/></mxCell><mxCell id="recapture-roi-formula" value="&lt;b&gt;工时再投资回收率与归因折算&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;破除“省 1,000 小时即赚 $72K”虚高口径，乘以有效再投资回收率（如 50%）与归因权重&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="310" width="320" height="98" as="geometry"/></mxCell><mxCell id="four-value-drivers" value="&lt;b&gt;四维商业价值与风险质量护栏&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;贯通效率、质量、营收与战略速度；用 Copilot Studio 追踪解决率与人工升级率&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="310" width="320" height="98" as="geometry"/></mxCell><mxCell id="adoption-habit-flywheel" value="&lt;b&gt;社区—采纳习惯双向飞轮&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;创作者与先锋沉淀信任，推动认知转化为日常依赖习惯，再由倡导者反哺壮大社区&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="526" width="320" height="98" as="geometry"/></mxCell><mxCell id="m365-admin-spend-policy" value="&lt;b&gt;M365 管理中心消费限额与预警&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;按人群、智能体与服务设定额度上限、告警与计费策略，透视高消耗团队与点数走势&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="526" width="320" height="98" as="geometry"/></mxCell><mxCell id="retirement-lifecycle-gate" value="&lt;b&gt;高风险人机协同与退役止损门禁&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;高危动作强制保留人工把关；预先约定调用跌破下限或成本超标时的主动下线条件&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="526" width="320" height="98" as="geometry"/></mxCell><mxCell id="e1" value="提报真实痛点" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="broken-workflow-intake" target="four-test-scorecard"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="四测全过入池" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="four-test-scorecard" target="portfolio-allocation"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="立项锁定基线" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="portfolio-allocation" target="five-prebuild-questions"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="测算真实净值" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="five-prebuild-questions" target="recapture-roi-formula"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="对齐四维指标" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="recapture-roi-formula" target="four-value-drivers"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="兑现价值促习惯" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="four-value-drivers" target="adoption-habit-flywheel"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="匹配点数预算" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="four-value-drivers" target="m365-admin-spend-policy"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="成本/低用度审计" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m365-admin-spend-policy" target="retirement-lifecycle-gate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="倡导者反哺下一轮痛点" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="adoption-habit-flywheel" target="broken-workflow-intake"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
