<mxfile host="Study-Room-Diagram-Engine" version="1"><diagram id="page-1" name="Copilot Managed Runtime 应用与 New Agent 企业级双轨 ALM 晋升流水线"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-track-cmr" value="轨道 A：Copilot Managed Runtime Apps 代码级 Git / CI/CD 晋升轨（@microsoft/cmr-cli）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=16;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1440" height="186" as="geometry"/></mxCell><mxCell id="group-track-agent" value="轨道 B：Microsoft Copilot Harness Agents 声明式定义与 Solution 晋升轨（msagent CLI）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=16;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="236" width="1440" height="186" as="geometry"/></mxCell><mxCell id="group-track-gov" value="跨环境配置隔离与双管理中心安全门禁（MAC + PPAC Governance Gates）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=16;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="448" width="1440" height="186" as="geometry"/></mxCell><mxCell id="cmr-extract" value="&lt;b&gt;1. 从个人环境克隆或 BYOB 初始化&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;ms app clone --app &amp;lt;id&amp;gt; 提取源码，并在目标环境执行 ms app create --repo none --environment-id &amp;lt;target&amp;gt;&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#E9B37D;strokeWidth=2;fontColor=#7C2D12;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="141" y="94" width="310" height="92" as="geometry"/></mxCell><mxCell id="cmr-overlay" value="&lt;b&gt;2. Stage Overlay 与共享连接校验&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;配置 ms.&amp;lt;stage&amp;gt;.config.json 覆盖连接与表；校验 sharedConnectionId 的 allowedActions&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF9E8;strokeColor=#D4B266;strokeWidth=2;fontColor=#713F12;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="605" y="94" width="310" height="92" as="geometry"/></mxCell><mxCell id="cmr-ci" value="&lt;b&gt;3. GitHub Actions SPN 打包与发布&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;开启 AllowExternalArtifactDeployment；通过 ms-app-pack 与 ms-app-deploy 自动上线&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="1069" y="94" width="310" height="92" as="geometry"/></mxCell><mxCell id="agent-clone" value="&lt;b&gt;1. msagent 克隆定义与 Git 纳管&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;拉取 settings.mcs.yml 与 workflows；将 .mcs/ 与 .config/agent.config.json 加入 .gitignore&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#E9B37D;strokeWidth=2;fontColor=#7C2D12;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="141" y="306" width="310" height="92" as="geometry"/></mxCell><mxCell id="agent-slot" value="&lt;b&gt;2. 多环境部署槽位与连接绑定&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;msagent deployment create 注册 dev/test/prod；按引用名执行 connection update&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF9E8;strokeColor=#D4B266;strokeWidth=2;fontColor=#713F12;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="605" y="306" width="310" height="92" as="geometry"/></mxCell><mxCell id="agent-promote" value="&lt;b&gt;3. 云端评测门禁与正式发布&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;msagent agent deploy 推送草稿 -&amp;gt; agent eval run 评测 -&amp;gt; --publish 发布（或走 Solution 管道）&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F2F7FB;strokeColor=#8FB5D2;strokeWidth=2;fontColor=#1E3A5F;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="1069" y="306" width="310" height="92" as="geometry"/></mxCell><mxCell id="gov-spn" value="&lt;b&gt;BAP API / Dataverse SPN 授权&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;无 Dataverse 环境通过 BAP API 赋权 EnvironmentAdmin（必须用 Enterprise App Object ID）&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F8F4FC;strokeColor=#B9A3D5;strokeWidth=2;fontColor=#4C1D95;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="141" y="518" width="310" height="92" as="geometry"/></mxCell><mxCell id="gov-policy" value="&lt;b&gt;环境组策略、ACP 与 CSP 沙盒&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;默认放行 19 个 Entra 认证一等连接器并拦截任意 HTTP 动作；强制 iframe CSP&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF9E8;strokeColor=#D4B266;strokeWidth=2;fontColor=#713F12;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="605" y="518" width="310" height="92" as="geometry"/></mxCell><mxCell id="gov-audit" value="&lt;b&gt;Purview 审计 (519) 与离职接管&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;监控 RecordType 519 与 P75 延迟；通过 ms admin add owner 移交源码与环境&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#78BDB5;strokeWidth=2;fontColor=#115E59;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="1069" y="518" width="310" height="92" as="geometry"/></mxCell><mxCell id="edge-1" value="解耦环境连接" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=13;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cmr-extract" target="cmr-overlay"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-2" value="构建并校验策略" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=13;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cmr-overlay" target="cmr-ci"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-3" value="声明目标环境" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=13;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="agent-clone" target="agent-slot"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-4" value="草稿评测与晋升" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=13;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="agent-slot" target="agent-promote"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-5" value="提供免人工凭证" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=13;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="gov-spn" target="cmr-ci"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-6" value="托管上线与遥测" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=13;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cmr-ci" target="gov-audit"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
