<mxfile host="Study-Room-Diagram-Engine" version="1"><diagram id="page-1" name="Copilot Studio 双环境错觉：UI 顶栏环境上下文与个人环境路由的脱钩解剖"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-authoring-plane" value="1. 入口层与界面顶栏假象（Authoring Entry &amp; UI Context）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=16;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1440" height="186" as="geometry"/></mxCell><mxCell id="group-routing-plane" value="2. 路由与控制平面分流（Routing &amp; Control Plane Split）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=16;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="236" width="1440" height="186" as="geometry"/></mxCell><mxCell id="group-storage-plane" value="3. 真实资产落盘与托管运行平面（Storage &amp; Hosting Data Plane）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=16;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="448" width="1440" height="186" as="geometry"/></mxCell><mxCell id="ui-picker" value="&lt;b&gt;Copilot Studio 顶栏环境选择器&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;显示用户手动选择的 Team-Dev；仅约束会话级 Agents/Flows 列表&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#78BDB5;strokeWidth=2;fontColor=#115E59;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="141" y="94" width="310" height="92" as="geometry"/></mxCell><mxCell id="app-tile" value="&lt;b&gt;New Experience: Apps / ms app create&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Copilot Studio App 磁贴、Cowork、Copilot Code 或 ms CLI&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="605" y="94" width="310" height="92" as="geometry"/></mxCell><mxCell id="agent-tile" value="&lt;b&gt;Agents / Workflows 创建入口&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Microsoft Copilot / Customer Conversation / Standard Harness&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#E9B37D;strokeWidth=2;fontColor=#7C2D12;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="1069" y="94" width="310" height="92" as="geometry"/></mxCell><mxCell id="token-geo" value="&lt;b&gt;Entra Token 构建期地理路由&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;按 PDL &amp;gt; 2字母 Country &amp;gt; 租户国家决定构建数据区（忽略顶栏环境）&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF9E8;strokeColor=#D4B266;strokeWidth=2;fontColor=#713F12;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="141" y="306" width="310" height="92" as="geometry"/></mxCell><mxCell id="cmr-routing" value="&lt;b&gt;CMR 强制环境路由（租户级不可关）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;忽略顶栏选择器，按 Everyone / 安全组规则强制导向个人环境&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="605" y="306" width="310" height="92" as="geometry"/></mxCell><mxCell id="ppac-routing" value="&lt;b&gt;PPAC 产品级环境路由判定&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;若开启 Copilot Studio 路由则初次跳个人环境；支持手动切回目标环境&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF9E8;strokeColor=#D4B266;strokeWidth=2;fontColor=#713F12;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="1069" y="306" width="310" height="92" as="geometry"/></mxCell><mxCell id="build-credit" value="&lt;b&gt;构建期计费与对话暂存&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Copilot Studio 环境计费池扣减构建 Credits；对话落盘于 Maker 地理区&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F8F4FC;strokeColor=#B9A3D5;strokeWidth=2;fontColor=#4C1D95;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="141" y="518" width="310" height="92" as="geometry"/></mxCell><mxCell id="personal-env" value="&lt;b&gt;Maker 专属个人环境（托管环境）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;初始无 Dataverse；承载 CMR App、平台 Git 仓、ms.config.json&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="605" y="518" width="310" height="92" as="geometry"/></mxCell><mxCell id="target-dataverse" value="&lt;b&gt;所选环境 Dataverse Solutions&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;承载 Agent (bot / botcomponent) 与 Workflow；含 Dataverse 库时受 60+15 天清理约束&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F2F7FB;strokeColor=#8FB5D2;strokeWidth=2;fontColor=#1E3A5F;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="1069" y="518" width="310" height="92" as="geometry"/></mxCell><mxCell id="edge-1" value="界面停留与构建计费归属" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=13;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ui-picker" target="build-credit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-2" value="解析登录令牌" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=13;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="app-tile" target="token-geo"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-3" value="默认无视顶栏环境" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=13;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="app-tile" target="cmr-routing"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-4" value="自动创建/复用个人环境" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=13;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cmr-routing" target="personal-env"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-5" value="检查环境上下文" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=13;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="agent-tile" target="ppac-routing"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-6" value="写入当前激活环境 Solution" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=13;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ppac-routing" target="target-dataverse"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
