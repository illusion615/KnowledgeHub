<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="Copilot Studio 跨生态受控读写与审计全栈架构（THRSP1119）"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-microsoft-estate-plane" value="1. 微软生态入口与编排层（Microsoft Estate: Copilot Studio + Work IQ + Agent 365）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1440" height="190" as="geometry"/></mxCell><mxCell id="group-connect-ai-control-plane" value="2. CData Connect AI 集中控制与语义层（Gateway · Context Engine · Scoped Toolkits）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="238" width="1440" height="190" as="geometry"/></mxCell><mxCell id="group-enterprise-data-plane" value="3. 异构企业记录系统与安全审计层（350+ MCP Connectors · Governed Write · SIEM）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="452" width="1440" height="190" as="geometry"/></mxCell><mxCell id="copilot-studio-agent" value="&lt;b&gt;Copilot Studio 智能体（Customer 360）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;通过官方认证连接器与每用户 OAuth 身份调用外部受控工具包&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="work-iq-semantic" value="&lt;b&gt;Work IQ 组织上下文与 Power BI 模型&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;承载 M365/Dataverse 语义，并将 PBIX 与 dbt 定义延伸至网关上下文图谱&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="agent365-frontdoor" value="&lt;b&gt;Agent 365 智能体发现与入口治理&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;统一管控智能体身份、可见性与租户合规边界，联动底层记录级治理&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="llm-mcp-gateway" value="&lt;b&gt;LLM &amp;amp; MCP 网关（预算封顶与路由）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;支持自带模型容灾切换（Sonnet/Opus/Mistral）、$1,000 月度限额与防注入护栏&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="context-engine-graph" value="&lt;b&gt;Context Engine 上下文图谱与词汇表&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;融合 Snowflake 语义视图、PBIX 与 Markdown 业务口径，按需检索省 93% 词元&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="scoped-toolkits-views" value="&lt;b&gt;受控工具包与虚拟派生视图（CRUD）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;收敛暴露表面积，通过跨源预连接视图与对象级 CRUD 权限收敛写入动作&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="multi-source-read" value="&lt;b&gt;350+ 跨生态实时读取（CRM/ITSM/数仓）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;按调用者自身凭据实时联邦查询 Salesforce、Zendesk、Snowflake、SAP 等源&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="governed-writeback" value="&lt;b&gt;人工确认与受控回写（Governed Write）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;健康分 37/100 低于阈值 40 时请求人工授权，在 Salesforce 安全创建跟进任务&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="full-stack-siem-audit" value="&lt;b&gt;四维全栈日志与 SIEM 实时流式审计&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;贯通 Query/Audit/LLM/MCP 四类日志，记录用户、SQL 耗时与受影响行并推送 SIEM&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="e1" value="认证连接器 + OAuth" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="copilot-studio-agent" target="llm-mcp-gateway"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="导入 PBIX / dbt 语义" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="work-iq-semantic" target="context-engine-graph"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="延伸数据层边界" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="agent365-frontdoor" target="scoped-toolkits-views"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="按需注入语义" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="llm-mcp-gateway" target="context-engine-graph"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="驱动精准工具调用" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="context-engine-graph" target="scoped-toolkits-views"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="服务端跨源联邦查询" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scoped-toolkits-views" target="multi-source-read"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="受控 CRUD 回写" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scoped-toolkits-views" target="governed-writeback"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="记录级追踪入 SIEM" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="governed-writeback" target="full-stack-siem-audit"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
