<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="Brown University Health 五维 AI 矩阵与床旁连接智能架构"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-sor-layer" value="1. 院内受控记录与知识底座（Systems of Record &amp; Governed M365 Knowledge）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="44" y="40" width="1032" height="186" as="geometry"/></mxCell><mxCell id="group-agentic-layer" value="2. 微软医疗连接智能与自定义智能体编排层（Copilot Studio · Healthcare Orchestrator · Foundry）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="44" y="260" width="1032" height="186" as="geometry"/></mxCell><mxCell id="group-delivery-layer" value="3. 床旁交付入口与企业级全链路审计（Point-of-Care Channels &amp; Purview / Agent 365）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="44" y="480" width="1032" height="186" as="geometry"/></mxCell><mxCell id="epic-ehr" value="&lt;b&gt;Epic 电子病历与影像检验&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;门诊/急诊病历 · 病理医嘱 · PACS/检验报告&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="76" y="112" width="312" height="90" as="geometry"/></mxCell><mxCell id="ed-sharepoint" value="&lt;b&gt;科室受控知识库（SharePoint）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;急诊本地指南 · 禁外网检索 · 仅限验证文档&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="404" y="112" width="312" height="90" as="geometry"/></mxCell><mxCell id="payer-rules" value="&lt;b&gt;医保预授权与编码规则集&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;敏感度标签管控 · 手术编码与商保核准标准&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="732" y="112" width="312" height="90" as="geometry"/></mxCell><mxCell id="copilot-studio" value="&lt;b&gt;Copilot Studio 沙盒构建台&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;189 名先锋自建 1,045 个智能体（55% 临床）&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="76" y="332" width="312" height="90" as="geometry"/></mxCell><mxCell id="hc-orchestrator" value="&lt;b&gt;Healthcare Orchestrator 路由&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;4 项配置挂载 BEM 指南 · 按意图分发问答&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="404" y="332" width="312" height="90" as="geometry"/></mxCell><mxCell id="foundry-copilot" value="&lt;b&gt;M365 Copilot 与 Foundry 科研飞地&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;单页 HTML 实训生成 · 肿瘤不良反应信号挖掘&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="732" y="332" width="312" height="90" as="geometry"/></mxCell><mxCell id="dragon-poc" value="&lt;b&gt;Dragon Copilot 床旁工作站&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;覆盖 3,000+ 临床医护 · 环境转录直连指南溯源&lt;/font&gt;" style="rounded