<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="Claude × Microsoft Foundry 三层智能体技术栈与大脑—双手解耦拓扑（THRSP1157）"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-portable-plane" value="0. 跨栈可移植业务资产层（Portable Domain Assets Across Any Stack）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1440" height="190" as="geometry"/></mxCell><mxCell id="group-harness-plane" value="1. 执行框架层：大脑编排循环与自建—托管光谱（Harness Plane: The Brain）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="238" width="1440" height="190" as="geometry"/></mxCell><mxCell id="group-infra-model-plane" value="2. 生产运行时沙盒与模型采购托管层（Infra Hands &amp; Claude Procurement）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="452" width="1440" height="190" as="geometry"/></mxCell><mxCell id="mcp-connectors" value="&lt;b&gt;MCP 企业系统连接器&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;标准化接入 CRM、工单系统、数据库与内部 API，跨五种技术栈零重写复用&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="agent-skills" value="&lt;b&gt;Agent Skills 团队作业规范&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;沉淀品牌准则、报告生成步骤与代码审查清单，教会智能体按团队标准行事&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="system-prompts" value="&lt;b&gt;领域提示词与安全凭据金库&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;定义产品专属推理目标，并将原始密钥隔离在执行沙盒外部的金库中&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="anthropic-harnesses" value="&lt;b&gt;Claude Agent SDK / Managed Agents&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;源自 Claude Code 的官方调优底座，或大脑—双手分离的长程托管服务（CMA）&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="microsoft-harnesses" value="&lt;b&gt;Microsoft Agent Framework / Studio&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;.NET/Python 多模型开源编排框架，或紧邻 M365 的零代码全托管构建平台&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="custom-messages-loop" value="&lt;b&gt;Messages API 自建控制循环&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;面向严苛平台团队提供裸金属级粒度控制，自行定制重试、权限与记忆机制&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="foundry-hosted-hands" value="&lt;b&gt;Foundry 托管智能体与自托管沙盒&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;每会话隔离容器、持久化文件、独立 Entra ID 身份与 App Insights 全链路追踪&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="foundry-claude-models" value="&lt;b&gt;Claude in Foundry（抵扣 MACC）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;可选 Azure 托管（支持 US Data Zone）或 Anthropic 托管（支持 Files/Skills）&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="anthropic-1p-cloud" value="&lt;b&gt;Anthropic 一方直采与云沙盒&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;解锁完整前沿特性（CMA 公测、Dreams、结果分级），支持私有化自托管部署&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="edge-1" value="工具协议挂载" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mcp-connectors" target="anthropic-harnesses"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-2" value="跨栈技能注入" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="agent-skills" target="microsoft-harnesses"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-3" value="指令与凭据隔离" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="system-prompts" target="custom-messages-loop"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-4" value="大脑与双手解耦" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="anthropic-harnesses" target="foundry-hosted-hands"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-5" value="Entra 认证与账单" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="microsoft-harnesses" target="foundry-claude-models"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-6" value="原生端点直连" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="custom-messages-loop" target="anthropic-1p-cloud"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
