<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="BRK265：Copilot Studio 业务流程转型与托管运行时统一控制平面"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-authoring-plane" value="1. 无断层同源创作入口（Zero-Cliff Git-Backed Authoring Surfaces）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1440" height="186" as="geometry"/></mxCell><mxCell id="group-composition-plane" value="2. 端到端业务流程三位一体组合层（Composable Apps, Workflows &amp; Agents）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="234" width="1440" height="186" as="geometry"/></mxCell><mxCell id="group-runtime-plane" value="3. 托管运行时、企业数据底座与集中治理（Copilot Managed Runtime &amp; Agent 365）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="444" width="1440" height="186" as="geometry"/></mxCell><mxCell id="cowork-entry" value="&lt;b&gt;Copilot Cowork 对话工作台&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;结合会议纪要与幻灯片上下文，多轮对话直接生成应用、工作流与智能体&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="94" width="320" height="92" as="geometry"/></mxCell><mxCell id="studio-canvas" value="&lt;b&gt;Copilot Studio 三位一体设计器&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;智能体、确定性工作流与新增应用磁贴同台编排，支持双栏预览与源码检视&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="94" width="320" height="92" as="geometry"/></mxCell><mxCell id="code-cli-git" value="&lt;b&gt;Copilot Code · CLI · 单一 Git 仓库&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;后台自动建库托管技能、提示词与源码；开发者随时拉取终端深加工&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="94" width="320" height="92" as="geometry"/></mxCell><mxCell id="agentic-apps" value="&lt;b&gt;动态智能体应用与对话微件（Apps &amp;amp; MCP UI）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;应用内一键指派任务给后台智能体；对话流内直接渲染动态地图与交互图表&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="304" width="320" height="92" as="geometry"/></mxCell><mxCell id="deterministic-workflows" value="&lt;b&gt;确定性工作流编排（Predictable Workflows）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;承接共享邮箱分流等固定弧线流程，按需嵌入分类抽取与跨智能体调用节点&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="304" width="320" height="92" as="geometry"/></mxCell><mxCell id="harness-agents" value="&lt;b&gt;安全沙盒长程智能体（Copilot Harness）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;隔离容器内置命令行与文件系统，多轮循环检索文档、生成文件并持久记忆&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="304" width="320" height="92" as="geometry"/></mxCell><mxCell id="managed-runtime" value="&lt;b&gt;Copilot 托管运行时（Managed Runtime GA）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;任意入口构建皆落入受管个人沙盒，默认集成企业身份、凭据代管与 Agent 365&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="514" width="320" height="92" as="geometry"/></mxCell><mxCell id="data-connectors" value="&lt;b&gt;Work IQ · 1,500+ 连接器 · Fabric 数据库&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;原生连接组织协作脉络，自动建表同步 Dataverse、SharePoint 与 Fabric 后端&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="514" width="320" height="92" as="geometry"/></mxCell><mxCell id="admin-finops" value="&lt;b&gt;M365 管理中心盘点 · Evals · FinOps&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;单点透视全组织应用与连接器策略，发布前评测阻断，按智能体设额度上限与隔离&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="514" width="320" height="92" as="geometry"/></mxCell><mxCell id="edge-1" value="对话生成界面" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cowork-entry" target="agentic-apps"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-2" value="编排确定性分支" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="studio-canvas" target="deterministic-workflows"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-3" value="代码与技能同步" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="code-cli-git" target="harness-agents"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-4" value="受管沙盒托管" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="agentic-apps" target="managed-runtime"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-5" value="受控读写数据" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="deterministic-workflows" target="data-connectors"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-6" value="评测与额度管控" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="harness-agents" target="admin-finops"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
