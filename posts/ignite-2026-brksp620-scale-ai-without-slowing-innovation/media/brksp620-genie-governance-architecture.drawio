<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="Gilead Sciences 企业智能体规模化三层运行模型（BRKSP620）"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-ideation-plane" value="1. 安全厨房与立项归口层（Safe Kitchen Sandboxes &amp; Idea Portal Intake）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1440" height="190" as="geometry"/></mxCell><mxCell id="group-governance-plane" value="2. 立项期前置治理与风险分级层（Governance at Ideation &amp; Risk-Proportional Triage）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="238" width="1440" height="190" as="geometry"/></mxCell><mxCell id="group-enterprise-plane" value="3. 可复用编排底座与分布式责任层（GENIE Orchestrator &amp; Distributed Ownership）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="452" width="1440" height="190" as="geometry"/></mxCell><mxCell id="safe-sandbox" value="&lt;b&gt;隔离租户与合成数据沙盒&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;提供创新安全厨房，阻断本机随意部署的影子原型接触受控数据&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="fde-champions" value="&lt;b&gt;前驻工程师与业务先锋网络&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;源自 300 席试点的自发先锋深入 15+ 业务团队，现场测算基线工时收益&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="idea-portal" value="&lt;b&gt;WinWire 共建创意门户（Idea Portal）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;统一归口逾 10,000 个智能体与自动化诉求，利用相似度聚类消除重复造轮子&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="data-redteam" value="&lt;b&gt;SharePoint 红队测试与防泄漏规则&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;严格剔除机密、个人身份与医疗健康隐私标签，受控试点 PubMed 与临床库连接器&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="rai-council" value="&lt;b&gt;负责任 AI 委员会与架构预审模式&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;安全、隐私、法务在立项期联席介入；命中企业架构认证模式即走快速通道&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="agentic-triage" value="&lt;b&gt;智能体辅助治理与实质人工把关&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;用智能体加速评审与跨部门草稿预检（法务修订从 50 处降至 5 处），杜绝橡皮图章&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="genie-orchestrator" value="&lt;b&gt;GENIE 企业主控编排器（Copilot Studio）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;基于 Teams 与 Work IQ 服务数千活跃员工，秒级检索政策地图并闭环数千张工单&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="domain-subagents" value="&lt;b&gt;法务/药政专职子智能体分布式共建&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;各业务线在主编排器下自主维护领域子智能体与技能，明确业务价值与责任主体&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="observability-roi" value="&lt;b&gt;全链路可观测性与采用率追踪平台&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;精准定位真正具备执行权的智能体节点、前后工时差，并辅导 50% 采用率团队&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="edge-1" value="合成数据脱敏验证" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="safe-sandbox" target="data-redteam"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-2" value="立项期拉通合规方" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="fde-champions" target="rai-council"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-3" value="智能去重与投资回报初筛" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="idea-portal" target="agentic-triage"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-4" value="继承权限与防泄漏边界" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="data-redteam" target="genie-orchestrator"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-5" value="认证架构模式放行" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="rai-council" target="domain-subagents"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-6" value="锁定工时基线与审计" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="agentic-triage" target="observability-roi"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
