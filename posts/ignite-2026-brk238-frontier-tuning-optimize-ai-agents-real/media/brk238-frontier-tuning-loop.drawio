<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="Frontier Tuning 企业学习闭环与三层调优架构（BRK238）"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-encode-plane" value="1. 业务编码与创作入口层（Step 01: Encode Work &amp; Authoring Canvases）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1440" height="188" as="geometry"/></mxCell><mxCell id="group-rle-plane" value="2. 统一强化学习环境与私有评测层（Step 02: Shared RLE &amp; Hardened Private Evals）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="236" width="1440" height="188" as="geometry"/></mxCell><mxCell id="group-climb-plane" value="3. 三环渐进爬坡与 Foundry 底座层（Step 03: Inner-to-Outer Hill-Climbing Loops）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="448" width="1440" height="188" as="geometry"/></mxCell><mxCell id="work-signals" value="&lt;b&gt;Work IQ · Fabric IQ · 轨迹信号&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;在 M365 合规边界内挖掘邮件、文档、会议录像与历史工具调用链&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="94" width="320" height="94" as="geometry"/></mxCell><mxCell id="sme-cowork" value="&lt;b&gt;Teams / Cowork 领域专家访谈&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;一键邀约业务专家问答录屏，将隐性评判经验固化为可执行评分准则&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="94" width="320" height="94" as="geometry"/></mxCell><mxCell id="authoring-cli" value="&lt;b&gt;Copilot Studio · GHCP 插件 · CLI&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;内置营销/人力/研发模板，一句话拉起调优并支持 Agent 365 统一治理&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="94" width="320" height="94" as="geometry"/></mxCell><mxCell id="rle-blocks" value="&lt;b&gt;四元调优环境（RLE 数字孪生）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;评测、训练与线上推理共享同一 Skills、Rubrics、Tools 与 Samples&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="306" width="320" height="94" as="geometry"/></mxCell><mxCell id="hardened-evals" value="&lt;b&gt;对抗准则加固与难例压力评测&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;封堵奖励作弊漏洞，树搜索主动挖掘模型断点并同步核算单任务成本&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="306" width="320" height="94" as="geometry"/></mxCell><mxCell id="virtual-tools" value="&lt;b&gt;工具虚拟化（Real / Shim / Mock）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;模拟 SAP、D365 与邮箱状态变迁，百次并发推演零脏数据、零误发邮件&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="306" width="320" height="94" as="geometry"/></mxCell><mxCell id="loop1-skill" value="&lt;b&gt;内环 Loop 1：技能蒸馏（Skill）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;零权重改动，优先迭代指令、上下文与准则并将胜出轨迹回写至技能&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="518" width="320" height="94" as="geometry"/></mxCell><mxCell id="loop2-harness" value="&lt;b&gt;中环 Loop 2：内核与 MCTS 树搜索&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;按准则剪枝推理路径并跨模型路由，树搜索增益直接充当微调潜力探针&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="518" width="320" height="94" as="geometry"/></mxCell><mxCell id="loop3-model" value="&lt;b&gt;外环 Loop 3：RFT + LoRA 模型微调&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;基于 Foundry 将业务专长固化进租户自持的 MAI / GPT-6 Luna 小模型权重&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="518" width="320" height="94" as="geometry"/></mxCell><mxCell id="edge-1" value="归纳工作流" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="work-signals" target="rle-blocks"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-2" value="校准专家准则" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sme-cowork" target="hardened-evals"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-3" value="挂载工具沙盒" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="authoring-cli" target="virtual-tools"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-4" value="内环优先调优" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="rle-blocks" target="loop1-skill"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-5" value="准则引导搜索" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hardened-evals" target="loop2-harness"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-6" value="无副作用 Rollout" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="virtual-tools" target="loop3-model"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
