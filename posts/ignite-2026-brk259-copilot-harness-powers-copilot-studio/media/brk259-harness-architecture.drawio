<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="Microsoft Copilot Harness 运行时架构与确定性护栏拓扑（BRK259）"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-entry-plane" value="1. 入口通道与会话预置层（Entry Channels, Session Init &amp; Variables）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1440" height="190" as="geometry"/></mxCell><mxCell id="group-harness-plane" value="2. Microsoft Copilot SDK 单循环执行与生命周期钩子层（Agentic Loop &amp; Hooks）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="238" width="1440" height="190" as="geometry"/></mxCell><mxCell id="group-sandbox-plane" value="3. Azure 容器沙盒、动态子智能体与信任边界层（Sandbox, Sub-Agents &amp; Trust）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="452" width="1440" height="190" as="geometry"/></mxCell><mxCell id="channels-protocols" value="&lt;b&gt;M365 · MCP / A2A 远程通道&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;以 OAuth 2.0 委托身份将智能体暴露为远程 MCP 工具或 A2A 协同节点&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="session-variables" value="&lt;b&gt;会话变量与可用性裁剪&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;注入部门/成本中心画像，按条件动态裁剪工具与知识源并锁定固定入参&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="modular-prompt" value="&lt;b&gt;模块化流程系统提示词&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;复用 Copilot SDK 底座并剥离纯编码片段，补齐跨部门业务流程编排语义&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="loop-controller" value="&lt;b&gt;六步自愈循环控制器&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;规划→组装提示→调模→解析→调工具→重算，83%–88% 输入词元命中缓存&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="pareto-router" value="&lt;b&gt;Auto 帕累托多模型路由&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;横跨 OpenAI、Anthropic、Mistral 与 xAI 四大厂商按任务复杂度动态选模&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="lifecycle-hooks" value="&lt;b&gt;6 类确定性生命周期钩子&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;在 Before/After Tool 等固定切点挂载阻断工作流，强制执行预算与脱敏策略&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="azure-sandbox" value="&lt;b&gt;Azure 隔离容器沙盒&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;提供独立 CLI、代码执行与本地磁盘文件系统，大体积表格落盘检索零爆窗&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="dynamic-subagents" value="&lt;b&gt;动态任务子智能体与外部代理&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;按需并行拉起轻量模型子代理独立评审，或混合编排 Foundry / SDK / A2A&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="trust-layer" value="&lt;b&gt;企业信任治理层（DLP / 标签）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;容器外隔离原始凭据，全量审计每次模型进出流量并强制继承敏感度标签&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="edge-1" value="委托身份触发" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="channels-protocols" target="loop-controller"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-2" value="画像与限额注入" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="session-variables" target="lifecycle-hooks"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-3" value="指令与分层路由" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="modular-prompt" target="pareto-router"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-4" value="CLI 与文件操作" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="loop-controller" target="azure-sandbox"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-5" value="异构模型派发" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pareto-router" target="dynamic-subagents"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-6" value="事前阻断与事后脱敏" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="lifecycle-hooks" target="trust-layer"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
