<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="Copilot Studio 自举式软件工厂：智能体、自动化与人机协同闭环（LIVE149）"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-signal-plane" value="1. 全天候感知与反馈采集层（Telemetry, User Signals &amp; Direct Prototyping）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1440" height="190" as="geometry"/></mxCell><mxCell id="group-factory-plane" value="2. 智能体软件工厂执行层（Dozens of Specialized Agents Running on Copilot Studio）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="238" width="1440" height="190" as="geometry"/></mxCell><mxCell id="group-delivery-plane" value="3. 人机门禁合入与生产环外溢层（Human-in-the-Loop Merge &amp; Work OS Platform）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="452" width="1440" height="190" as="geometry"/></mxCell><mxCell id="prod-telemetry" value="&lt;b&gt;生产遥测与运行监控流&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;实时捕捉线上报错、工具调用瓶颈与早期测试环运行信号&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="social-feedback" value="&lt;b&gt;外部用户反馈与录屏动态&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;倾听社区与 LinkedIn 详细复现视频，让真实用户直接触发改进循环&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="designer-pr" value="&lt;b&gt;跨职能角色直接提交 PR（&amp;gt;50% 设计师）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;告别数周焦点小组与静态稿排期，设计师直接动手实现可运行原型&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="triage-repro-agent" value="&lt;b&gt;夜间复现与问题核验智能体&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;当晚自动拾取外部痛点报告，独立核查并确认缺陷真实可复现&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="coding-agent" value="&lt;b&gt;代码修复与特性构建智能体&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;打破“写代码最慢最难”旧假设，自动编写补丁与新功能实现分支&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="validation-agent" value="&lt;b&gt;自动化验证与双倍覆盖测试流&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;用智能体与确定性自动化流检验补丁，朝预算减半且覆盖翻倍演进&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="hitl-merge" value="&lt;b&gt;人在回路晨间合入（24h 闭环回访）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;工程师把关架构与合入红线，次晨合并并在 24 小时内通知用户补丁在途&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="ring-rollout" value="&lt;b&gt;早期用户环试穿与生产加固&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;先内部上手感受再推送早期用户环实测，筛选高价值能力加固推向主干&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="work-os-customers" value="&lt;b&gt;工作操作系统外溢（Markel 等客户）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;将同源底座赋能财务、政务与航运承保（18h 窗口内决策提速 3 倍+）&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="e1" value="异常信号" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="prod-telemetry" target="triage-repro-agent"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="当晚拾取" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="social-feedback" target="triage-repro-agent"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="直接实现" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="designer-pr" target="coding-agent"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="确认缺陷" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="triage-repro-agent" target="coding-agent"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="提交候选补丁" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="coding-agent" target="validation-agent"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="验证通过" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="validation-agent" target="hitl-merge"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="推入环境" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hitl-merge" target="ring-rollout"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="平台化赋能" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ring-rollout" target="work-os-customers"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
