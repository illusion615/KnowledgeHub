<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="系统架构图"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-input-layer" value="1. 统一多模态条件输入层（Lyrics · Style · Reference）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="44" y="40" width="992" height="184" as="geometry"/></mxCell><mxCell id="group-paradigm-layer" value="2. 三大核心生成范式主干（AR Symbolic vs Hybrid-LM vs Pure Flow DiT）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="44" y="258" width="992" height="184" as="geometry"/></mxCell><mxCell id="group-synthesis-layer" value="3. 连续潜空间声学合成与立体声解码（Flow Matching + Stereo VAE / DAC）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="44" y="476" width="992" height="184" as="geometry"/></mxCell><mxCell id="lyric-cond" value="&lt;b&gt;段落标签与多语种歌词&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;[Verse] / [Chorus] 独立行 · G2P 音素映射&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="158" y="112" width="292" height="88" as="geometry"/></mxCell><mxCell id="style-cond" value="&lt;b&gt;结构化曲风与参考音频&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;BPM / 调式 / 配器演进 · 零样本翻唱旋律参考&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="630" y="112" width="292" height="88" as="geometry"/></mxCell><mxCell id="ar-symbolic" value="&lt;b&gt;白盒乐谱 AR-NAR（YuE2-3B）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;先生成可编辑 ABC 旋律和弦谱，再自回归语义令牌&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="79" y="330" width="292" height="88" as="geometry"/></mxCell><mxCell id="hybrid-lm" value="&lt;b&gt;分层连续隐态（MiniMax Music 3）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;8B Global + 0.6B RVQ 隐态直通 2.4B Flow DiT&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="394" y="330" width="292" height="88" as="geometry"/></mxCell><mxCell id="fast-flow" value="&lt;b&gt;极速潜空间流匹配（ACE-Step / 谛韵）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;5Hz 轻量规划或非自回归全帧并行，8 步秒级成曲&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="709" y="330" width="292" height="88" as="geometry"/></mxCell><mxCell id="euler-flow" value="&lt;b&gt;流匹配声学求解器 (Euler/PingPong)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;DCAE / 200帧滑窗潜变量去噪 · 双分支 CFG 引导&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="158" y="548" width="292" height="88" as="geometry"/></mxCell><mxCell id="stereo-vae" value="&lt;b&gt;高采样率立体声声码器&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;32kHz~48kHz 双声道 WAV/FLAC（FP32 保真解码）&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="630" y="548" width="292" height="88" as="geometry"/></mxCell><mxCell id="edge-1" value="词谱对齐" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="lyric-cond" target="ar-symbolic"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-2" value="25Hz 帧规划" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="lyric-cond" target="hybrid-lm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-3" value="全局条件" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="style-cond" target="fast-flow"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-4" value="语义令牌" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ar-symbolic" target="euler-flow"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-5" value="连续隐态融合" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hybrid-lm" target="euler-flow"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-6" value="8~30 步采样" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="fast-flow" target="euler-flow"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-7" value="声学潜变量" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="euler-flow" target="stereo-vae"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
