<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="Microsoft × Cyera 分类感知 Copilot 智能体五环联合防线（THRSP1104）"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-trusted-data-plane" value="1. 可信数据分类与可达边界映射层（Cyera DSPM + Microsoft Purview）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1440" height="192" as="geometry"/></mxCell><mxCell id="group-risk-inventory-plane" value="2. 全域智能体盘点与融合风险关联层（Agent 365 + Microsoft Defender + Entra ID）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="1440" height="192" as="geometry"/></mxCell><mxCell id="group-runtime-enforcement-plane" value="3. 双粒度运行时拦截与持续合规闭环（Action-Level Block vs. Agent Quarantine）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="456" width="1440" height="192" as="geometry"/></mxCell><mxCell id="cyera-dspm" value="&lt;b&gt;Cyera DSPM 敏感数据扫描分类&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;识别薪酬/W2、并购标的、SOX 审计与候选人档案，定位真实业务价值&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="94" width="320" height="98" as="geometry"/></mxCell><mxCell id="purview-labels" value="&lt;b&gt;Microsoft Purview 敏感度标签与 DLP&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;自动下发敏感度标签至 SharePoint 与 Dataverse，驱动原生知识库策略&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="94" width="320" height="98" as="geometry"/></mxCell><mxCell id="entra-reach-graph" value="&lt;b&gt;Entra 服务主体与意图越界比对&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;审视制作者共享连接（Maker Connection）是否超范围触达受限跨域文件&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="94" width="320" height="98" as="geometry"/></mxCell><mxCell id="copilot-pp-inventory" value="&lt;b&gt;Copilot Studio 与 Power Platform 资产&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;双向同步智能体指令、发布渠道、Outlook/MCP 工具及业务责任人清单&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="310" width="320" height="98" as="geometry"/></mxCell><mxCell id="agent365-risk-hub" value="&lt;b&gt;Agent 365 动态风险面板（M365 管理台）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;拆解运行时风险、暴露面风险与爆炸半径，筛查无主与待审智能体&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="310" width="320" height="98" as="geometry"/></mxCell><mxCell id="defender-guardian-fusion" value="&lt;b&gt;Defender + Cyera Agent Guardian 合流&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;同一案件（INC-48625）关联 XPIA 提示词注入与未授权群聊/外部 Gmail 泄密&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="310" width="320" height="98" as="geometry"/></mxCell><mxCell id="action-level-block" value="&lt;b&gt;动作级精准拦截（Action Enforcement）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;仅阻断违规外发薪酬邮件并留存四元组证据，其余常规 HR 问答照常服务&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="526" width="320" height="98" as="geometry"/></mxCell><mxCell id="agent-quarantine" value="&lt;b&gt;整机隔离熔断（Agent Quarantine）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;联动 Power Automate Premium 一键冻结失控智能体，待责任人收敛范围后解封&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="526" width="320" height="98" as="geometry"/></mxCell><mxCell id="continuous-attestation" value="&lt;b&gt;持续合规验证（告别年度手工审计）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;新增智能体与身份自动注入数据上下文，随时向审计与监管机构出具证据链&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="526" width="320" height="98" as="geometry"/></mxCell><mxCell id="e1" value="自动打标" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cyera-dspm" target="purview-labels"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="分类上下文" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="purview-labels" target="agent365-risk-hub"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="越权暴露面" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="entra-reach-graph" target="defender-guardian-fusion"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="全量纳管" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="copilot-pp-inventory" target="agent365-risk-hub"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="单次违规拦截" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="agent365-risk-hub" target="action-level-block"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="高危案件熔断" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="defender-guardian-fusion" target="agent-quarantine"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="缩权复核归档" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="agent-quarantine" target="continuous-attestation"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
