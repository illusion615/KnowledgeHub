<mxfile host="Study-Room-Diagram-Engine" version="1"><diagram id="page-1" name="文章图表生成与验证流程"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="detect" value="&lt;b&gt;识别文章中的绘图需求&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;架构图或流程图&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#E9B37D;strokeWidth=2;fontColor=#7C2D12;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="615" y="32" width="270" height="72" as="geometry"/></mxCell><mxCell id="model" value="&lt;b&gt;生成 DiagramSpec&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;一次定义中英文语义&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F7F8F9;strokeColor=#AAB4C0;strokeWidth=2;fontColor=#334155;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="615" y="142" width="270" height="72" as="geometry"/></mxCell><mxCell id="preflight" value="&lt;b&gt;执行编译前校验&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;schema、双语、引用与循环&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF9E8;strokeColor=#D4B266;strokeWidth=2;fontColor=#713F12;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="615" y="252" width="270" height="72" as="geometry"/></mxCell><mxCell id="layout" value="&lt;b&gt;计算布局与连接线&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;固定矩形与正交路径&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F2F7FB;strokeColor=#8FB5D2;strokeWidth=2;fontColor=#1E3A5F;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="450" y="362" width="270" height="72" as="geometry"/></mxCell><mxCell id="revise-spec" value="&lt;b&gt;返回修订 DiagramSpec&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;闸门失败时停止发布&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#E9B37D;strokeWidth=2;fontColor=#7C2D12;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="780" y="362" width="270" height="72" as="geometry"/></mxCell><mxCell id="post-layout" value="&lt;b&gt;执行布局后检查&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;逐对检查节点重叠&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF9E8;strokeColor=#D4B266;strokeWidth=2;fontColor=#713F12;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="615" y="472" width="270" height="72" as="geometry"/></mxCell><mxCell id="assets" value="&lt;b&gt;写入三份图表资产&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Draw.io + 中文 SVG + 英文 SVG&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F7F8F9;strokeColor=#AAB4C0;strokeWidth=2;fontColor=#334155;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="450" y="582" width="270" height="72" as="geometry"/></mxCell><mxCell id="revise-layout" value="&lt;b&gt;返回修订布局参数&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;调整层级、画布或尺寸&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#E9B37D;strokeWidth=2;fontColor=#7C2D12;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="780" y="582" width="270" height="72" as="geometry"/></mxCell><mxCell id="embed" value="&lt;b&gt;嵌入文章与演示模式&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;按当前语言选择 SVG&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#78BDB5;strokeWidth=2;fontColor=#115E59;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="615" y="692" width="270" height="72" as="geometry"/></mxCell><mxCell id="visual-gate" value="&lt;b&gt;执行浏览器视觉检查&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;桌面、手机、亮暗主题与 PPT&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF9E8;strokeColor=#D4B266;strokeWidth=2;fontColor=#713F12;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="450" y="802" width="270" height="72" as="geometry"/></mxCell><mxCell id="revise-page" value="&lt;b&gt;返回修订页面容器&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;修复截断或导航侵入&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#E9B37D;strokeWidth=2;fontColor=#7C2D12;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="780" y="802" width="270" height="72" as="geometry"/></mxCell><mxCell id="rerun-spec" value="&lt;b&gt;新一轮从规格校验重跑&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;使用修订后的 DiagramSpec&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F7F8F9;strokeColor=#AAB4C0;strokeWidth=2;fontColor=#334155;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="120" y="912" width="270" height="72" as="geometry"/></mxCell><mxCell id="rerun-layout" value="&lt;b&gt;新一轮从布局重跑&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;使用修订后的布局参数&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F7F8F9;strokeColor=#AAB4C0;strokeWidth=2;fontColor=#334155;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="450" y="912" width="270" height="72" as="geometry"/></mxCell><mxCell id="publish" value="&lt;b&gt;通过最终发布闸门&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;文章、演示与 PPT 可发布&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#78BDB5;strokeWidth=2;fontColor=#115E59;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="780" y="912" width="270" height="72" as="geometry"/></mxCell><mxCell id="rerun-page" value="&lt;b&gt;新一轮从页面验收重跑&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;使用修订后的页面容器&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F7F8F9;strokeColor=#AAB4C0;strokeWidth=2;fontColor=#334155;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="1110" y="912" width="270" height="72" as="geometry"/></mxCell><mxCell id="edge-1" value="确定信息边界" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;en