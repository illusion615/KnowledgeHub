{
  "version": 1,
  "type": "sequence",
  "title": {
    "zh": "图表能力融入 Knowledge Hub 的交互时序",
    "en": "Interaction Sequence for Integrating Diagrams into Knowledge Hub"
  },
  "layout": {
    "width": 1500,
    "participantWidth": 220,
    "participantHeight": 58,
    "messageStartY": 138,
    "messageGap": 66,
    "marginX": 120,
    "marginY": 28,
    "showTitle": false,
    "showCanvas": false
  },
  "participants": [
    { "id": "content-agent", "label": { "zh": "AI 内容 Agent", "en": "AI Content Agent" } },
    { "id": "diagram-engine", "label": { "zh": "Diagram Engine", "en": "Diagram Engine" } },
    { "id": "artifact-store", "label": { "zh": "图表资产仓库", "en": "Diagram Artifact Store" } },
    { "id": "article-runtime", "label": { "zh": "文章运行时", "en": "Article Runtime" } },
    { "id": "reviewer", "label": { "zh": "浏览器验收", "en": "Browser Acceptance" } }
  ],
  "messages": [
    {
      "from": "content-agent", "to": "diagram-engine",
      "label": { "zh": "compile(DiagramSpec)", "en": "compile(DiagramSpec)" }
    },
    {
      "from": "diagram-engine", "to": "diagram-engine",
      "label": { "zh": "校验 schema、双语与引用", "en": "Validate Schema, Locales, and References" }
    },
    {
      "from": "diagram-engine", "to": "content-agent", "kind": "response",
      "label": { "zh": "失败时返回字段诊断", "en": "Return Field Diagnostics on Failure" }
    },
    {
      "from": "diagram-engine", "to": "diagram-engine",
      "label": { "zh": "计算容器、节点与连线路由", "en": "Layout Containers, Nodes, and Routes" }
    },
    {
      "from": "diagram-engine", "to": "diagram-engine",
      "label": { "zh": "检查边界归属与节点重叠", "en": "Check Boundaries and Node Overlap" }
    },
    {
      "from": "diagram-engine", "to": "artifact-store",
      "label": { "zh": "写入 JSON、Draw.io 与双语 SVG", "en": "Write JSON, Draw.io, and Bilingual SVG" }
    },
    {
      "from": "artifact-store", "to": "article-runtime",
      "label": { "zh": "按页面语言加载 SVG", "en": "Load SVG for the Active Locale" }
    },
    {
      "from": "article-runtime", "to": "reviewer",
      "label": { "zh": "渲染阅读、演示与 PPT 场景", "en": "Render Reading, Presentation, and PPT" }
    },
    {
      "from": "reviewer", "to": "content-agent", "kind": "response",
      "label": { "zh": "返回截断、密度或导航问题", "en": "Return Clipping, Density, or Navigation Issues" }
    },
    {
      "from": "content-agent", "to": "diagram-engine",
      "label": { "zh": "提交修订后的规格或布局参数", "en": "Submit Revised Spec or Layout Parameters" }
    },
    {
      "from": "diagram-engine", "to": "artifact-store",
      "label": { "zh": "重新生成并覆盖候选资产", "en": "Regenerate and Replace Candidate Assets" }
    }
  ]
}