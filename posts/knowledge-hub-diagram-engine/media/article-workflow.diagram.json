{
  "version": 1,
  "type": "flowchart",
  "title": {
    "zh": "文章图表生成与验证流程",
    "en": "Article Diagram Generation and Validation Flow"
  },
  "layout": {
    "direction": "down",
    "width": 1500,
    "nodeWidth": 270,
    "nodeHeight": 72,
    "columnGap": 38,
    "rowGap": 60,
    "marginY": 32,
    "showTitle": false,
    "showCanvas": false
  },
  "nodes": [
    {
      "id": "detect",
      "layer": 0,
      "role": "actor",
      "label": { "zh": "识别文章中的绘图需求", "en": "Detect a Diagram Need" },
      "detail": { "zh": "架构图或流程图", "en": "Architecture or Flowchart" }
    },
    {
      "id": "model",
      "layer": 1,
      "role": "artifact",
      "label": { "zh": "生成 DiagramSpec", "en": "Create DiagramSpec" },
      "detail": { "zh": "一次定义中英文语义", "en": "Define Both Locales Once" }
    },
    {
      "id": "preflight",
      "layer": 2,
      "role": "control",
      "label": { "zh": "执行编译前校验", "en": "Run Preflight Validation" },
      "detail": { "zh": "schema、双语、引用与循环", "en": "Schema, Locales, References, Cycles" }
    },
    {
      "id": "layout",
      "layer": 3,
      "order": 1,
      "role": "service",
      "label": { "zh": "计算布局与连接线", "en": "Calculate Layout and Connectors" },
      "detail": { "zh": "固定矩形与正交路径", "en": "Fixed Rectangles and Orthogonal Paths" }
    },
    {
      "id": "revise-spec",
      "layer": 3,
      "order": 2,
      "role": "actor",
      "label": { "zh": "返回修订 DiagramSpec", "en": "Return to Revise DiagramSpec" },
      "detail": { "zh": "闸门失败时停止发布", "en": "Stop Publication on Failure" }
    },
    {
      "id": "post-layout",
      "layer": 4,
      "role": "control",
      "label": { "zh": "执行布局后检查", "en": "Run Post-Layout Checks" },
      "detail": { "zh": "逐对检查节点重叠", "en": "Pairwise Node Overlap Check" }
    },
    {
      "id": "assets",
      "layer": 5,
      "order": 1,
      "role": "artifact",
      "label": { "zh": "写入三份图表资产", "en": "Write Three Diagram Assets" },
      "detail": { "zh": "Draw.io + 中文 SVG + 英文 SVG", "en": "Draw.io + Chinese SVG + English SVG" }
    },
    {
      "id": "revise-layout",
      "layer": 5,
      "order": 2,
      "role": "actor",
      "label": { "zh": "返回修订布局参数", "en": "Return to Revise Layout Parameters" },
      "detail": { "zh": "调整层级、画布或尺寸", "en": "Adjust Layers, Canvas, or Size" }
    },
    {
      "id": "embed",
      "layer": 6,
      "role": "interface",
      "label": { "zh": "嵌入文章与演示模式", "en": "Embed in Article and Presentation" },
      "detail": { "zh": "按当前语言选择 SVG", "en": "Select SVG by Active Locale" }
    },
    {
      "id": "visual-gate",
      "layer": 7,
      "order": 1,
      "role": "control",
      "label": { "zh": "执行浏览器视觉检查", "en": "Run Browser Visual Review" },
      "detail": { "zh": "桌面、手机、亮暗主题与 PPT", "en": "Desktop, Mobile, Themes, and PPT" }
    },
    {
      "id": "revise-page",
      "layer": 7,
      "order": 2,
      "role": "actor",
      "label": { "zh": "返回修订页面容器", "en": "Return to Revise Page Container" },
      "detail": { "zh": "修复截断或导航侵入", "en": "Fix Clipping or Navigation Intrusion" }
    },
    {
      "id": "rerun-spec",
      "layer": 8,
      "order": 1,
      "role": "artifact",
      "label": { "zh": "新一轮从规格校验重跑", "en": "New Run from Spec Validation" },
      "detail": { "zh": "使用修订后的 DiagramSpec", "en": "Use the Revised DiagramSpec" }
    },
    {
      "id": "rerun-layout",
      "layer": 8,
      "order": 2,
      "role": "artifact",
      "label": { "zh": "新一轮从布局重跑", "en": "New Run from Layout" },
      "detail": { "zh": "使用修订后的布局参数", "en": "Use Revised Layout Parameters" }
    },
    {
      "id": "publish",
      "layer": 8,
      "order": 3,
      "role": "interface",
      "label": { "zh": "通过最终发布闸门", "en": "Pass the Final Publication Gate" },
      "detail": { "zh": "文章、演示与 PPT 可发布", "en": "Article, Presentation, and PPT Ready" }
    },
    {
      "id": "rerun-page",
      "layer": 8,
      "order": 4,
      "role": "artifact",
      "label": { "zh": "新一轮从页面验收重跑", "en": "New Run from Page Acceptance" },
      "detail": { "zh": "使用修订后的页面容器", "en": "Use the Revised Page Container" }
    }
  ],
  "edges": [
    { "from": "detect", "to": "model", "label": { "zh": "确定信息边界", "en": "Set Scope" } },
    { "from": "model", "to": "preflight", "label": { "zh": "提交单一语义源", "en": "Submit One Semantic Source" } },
    { "from": "preflight", "to": "layout", "label": { "zh": "通过", "en": "Pass" } },
    { "from": "preflight", "to": "revise-spec", "label": { "zh": "失败", "en": "Fail" } },
    { "from": "layout", "to": "post-layout", "label": { "zh": "提交几何模型", "en": "Submit Geometry Model" } },
    { "from": "post-layout", "to": "assets", "label": { "zh": "通过", "en": "Pass" } },
    { "from": "post-layout", "to": "revise-layout", "label": { "zh": "失败", "en": "Fail" } },
    { "from": "assets", "to": "embed", "label": { "zh": "嵌入静态产物", "en": "Embed Static Assets" } },
    { "from": "embed", "to": "visual-gate", "label": { "zh": "检查最终上下文", "en": "Review Final Context" } },
    { "from": "visual-gate", "to": "revise-page", "label": { "zh": "失败", "en": "Fail" } },
    { "from": "visual-gate", "to": "publish", "label": { "zh": "通过", "en": "Pass" } },
    { "from": "revise-spec", "to": "rerun-spec", "label": { "zh": "提交下一轮", "en": "Submit Next Run" } },
    { "from": "revise-layout", "to": "rerun-layout", "label": { "zh": "提交下一轮", "en": "Submit Next Run" } },
    { "from": "revise-page", "to": "rerun-page", "label": { "zh": "提交下一轮", "en": "Submit Next Run" } }
  ]
}