<mxfile host="Study-Room-Diagram-Engine" version="1"><diagram id="page-1" name="方案 C：反向近实时投影与同步校验架构"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-client" value="Power Platform 消费端" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=16;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1420" height="184" as="geometry"/></mxCell><mxCell id="group-dataverse" value="Microsoft Dataverse" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=16;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="1420" height="184" as="geometry"/></mxCell><mxCell id="group-integration" value="双路集成中台 [我们实施]" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=16;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="456" width="1420" height="184" as="geometry"/></mxCell><mxCell id="group-crm" value="既有 CRM [职责：开放两类边界约束]" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F5FAF8;strokeColor=#C5DDD8;fontColor=#115E59;fontSize=16;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="672" width="1420" height="184" as="geometry"/></mxCell><mxCell id="apps" value="&lt;b&gt;Power Apps Code App / Agents&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;基于新鲜度标识降级，分离关键动作路由&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#78BDB5;strokeWidth=2;fontColor=#115E59;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="560" y="96" width="380" height="88" as="geometry"/></mxCell><mxCell id="proj" value="&lt;b&gt;Dataverse Projection&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;只读投影 (附带来源版本号与同步时间戳)&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F8F4FC;strokeColor=#B9A3D5;strokeWidth=2;fontColor=#4C1D95;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="560" y="312" width="380" height="88" as="geometry"/></mxCell><mxCell id="apim" value="&lt;b&gt;Azure API Management&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;订单库存等强校验拦截动作提交的网关&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F2F7FB;strokeColor=#8FB5D2;strokeWidth=2;fontColor=#1E3A5F;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="903" y="528" width="380" height="88" as="geometry"/></mxCell><mxCell id="async" value="&lt;b&gt;Azure Service Bus + Functions&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;事件缓冲对列、提取最新版本以防倒旧写&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF9E8;strokeColor=#D4B266;strokeWidth=2;fontColor=#713F12;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="217" y="528" width="380" height="88" as="geometry"/></mxCell><mxCell id="crm-api" value="&lt;b&gt;Legacy CRM REST API&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;提供源版本号 (RowVersion) 的乐观锁接口&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F8F4FC;strokeColor=#B9A3D5;strokeWidth=2;fontColor=#4C1D95;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="903" y="744" width="380" height="88" as="geometry"/></mxCell><mxCell id="crm-event" value="&lt;b&gt;Legacy CRM Event Publisher&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;基于 CDC / Webhook 吐出规范化主件流&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F2F7FB;strokeColor=#8FB5D2;strokeWidth=2;fontColor=#1E3A5F;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="217" y="744" width="380" height="88" as="geometry"/></mxCell><mxCell id="edge-1" value="默认超高响应读取链路" style="edgeStyle=orthogonalEdge