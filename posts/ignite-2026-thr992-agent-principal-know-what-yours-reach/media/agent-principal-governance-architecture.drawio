<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="Copilot Studio 智能体主体生命周期与三门户协同治理架构（THR992）"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-maker-build-plane" value="1. 构建平面：Copilot Studio 双底座与连接器挂载（Maker Authoring Plane）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1440" height="190" as="geometry"/></mxCell><mxCell id="group-entra-identity-plane" value="2. 身份与策略平面：Microsoft Entra 强制智能体主体（Entra Principal Plane）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="238" width="1440" height="190" as="geometry"/></mxCell><mxCell id="group-admin-sec-plane" value="3. 全景治理与合规平面：Agent 365 · Power Platform · Purview" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="452" width="1440" height="190" as="geometry"/></mxCell><mxCell id="copilot-harness" value="&lt;b&gt;Copilot 底座（Onboarding Buddy）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;原 GitHub Copilot 底座；草稿态零身份，首次点击 Publish 时创建主体&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="standard-harness" value="&lt;b&gt;标准底座（Expense Desk）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;命名新建即刻在 Entra 铸造主体；发布后写入第一方连接器聚合权限&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="legacy-2025-bot" value="&lt;b&gt;2025 存量智能体（Onboarding Bot）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;仅具 Application ID 与企业应用标签，缺省蓝图、保荐人与条件访问&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="agent-blueprint" value="&lt;b&gt;单一蓝图与保荐人（Blueprint &amp;amp; Sponsor）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Copilot Studio 全租户共享唯一蓝图模板；创建者默认绑定生命周期保荐人&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="connector-scopes" value="&lt;b&gt;Granted Permissions 连接器范围&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;标准底座聚合成 Azure API Connections Runtime.All；MCP 与自定义连接器留白&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="conditional-access" value="&lt;b&gt;Conditional Access 条件访问引擎&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;发令牌前校验智能体风险；当前支持高风险阻断（无人工 MFA 或设备合规）&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="agent-365-hub" value="&lt;b&gt;M365 管理中心（Agent 365 与拓扑图）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;免进 Studio 直读知识库、指令、底层 API 路径与 Work IQ MCP 调用并一键封禁&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="pp-dlp-policies" value="&lt;b&gt;Power Platform 环境与数据策略&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;管控环境边界、连接器动作级白名单（May Do）与存量智能体预览迁移&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="purview-defender" value="&lt;b&gt;Purview 敏感交互与离职交接闭环&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;审计敏感数据交互标签，并将保荐人纳入员工入转调离（JML）制度&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="e1" value="首次发布铸造" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="copilot-harness" target="agent-blueprint"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="新建即刻铸造" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="standard-harness" target="agent-blueprint"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="写入 Runtime.All" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="standard-harness" target="connector-scopes"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="预览迁移/重建" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="legacy-2025-bot" target="pp-dlp-policies"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="全量策略继承" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="agent-blueprint" target="conditional-access"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="统一身份映射" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="agent-blueprint" target="agent-365-hub"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="May Call ⊕ DLP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="connector-scopes" target="pp-dlp-policies"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="敏感交互审计" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="agent-365-hub" target="purview-defender"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
