<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="Work IQ 企业智能底座三层架构：从数据脉络到全平台智能体动作"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-exp-platforms" value="1. 顶层体验与多平台宿主（Copilot Studio · GitHub · VS Code / Claude / ChatGPT / n8n）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="44" y="40" width="992" height="186" as="geometry"/></mxCell><mxCell id="group-work-iq-core" value="2. Work IQ 智能与协议层（MCP · REST · A2A | 13 动词 × 路径 | A365 治理）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="44" y="260" width="992" height="186" as="geometry"/></mxCell><mxCell id="group-data-connectors" value="3. 组织信号与业务记录系统（Microsoft 365 协作图谱 · Dataverse · 300+ 连接器）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="44" y="480" width="992" height="186" as="geometry"/></mxCell><mxCell id="studio-cowork" value="&lt;b&gt;Copilot Studio 与协同智能体&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;默认开启 Work IQ · 跨角色权限裁剪问答&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="79" y="112" width="292" height="90" as="geometry"/></mxCell><mxCell id="dev-workflows" value="&lt;b&gt;GitHub Actions 与研发编辑器&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;每次 PR 自动核对业务决议 · 本地直连 MCP&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;