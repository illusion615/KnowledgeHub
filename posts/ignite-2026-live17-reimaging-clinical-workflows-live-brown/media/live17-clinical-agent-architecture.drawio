<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="Brown University Health 临床与运营智能体三层架构（LIVE17 实录）"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-enablement-plane" value="1. 分层构建与临床冠军赋能层（Grassroots &amp; Top-Down Enablement）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1440" height="190" as="geometry"/></mxCell><mxCell id="group-governance-plane" value="2. AI 卓越中心风险分级与全域治理层（Risk-Based CoE &amp; Purview / Agent 365）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="238" width="1440" height="190" as="geometry"/></mxCell><mxCell id="group-delivery-plane" value="3. 床旁电子病历与办公双轨触达层（Point-of-Care EHR &amp; Knowledge Endpoints）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="452" width="1440" height="190" as="geometry"/></mxCell><mxCell id="copilot-chat-base" value="&lt;b&gt;全员安全基座：Copilot Chat&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;面向约 20,000 名员工开放受保护健康信息（PHI）隔离对话，约 8,000 人活跃使用&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="clinician-studio" value="&lt;b&gt;临床构建者沙盒：Copilot Studio&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;赋能 189 名一线医生与先锋自建 1,045 个智能体（如神经外科术前与医保预授权代理）&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="foundry-iq" value="&lt;b&gt;科研飞地与本地知识：Foundry + Work IQ&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;科研团队调用 Microsoft Foundry，临床代理严格锁死院内 SharePoint/Teams 指南禁公网&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="coe-sandbox-discovery" value="&lt;b&gt;AI 卓越中心（AI CoE）双向孵化&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;实时透视沙盒高价值原型主动帮扶扩规模，或承接一线构建者的生产晋升申请&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="risk-tiered-gate" value="&lt;b&gt;临床风险分级验证与审批门禁&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;触及患者诊疗决策划为高风险执行严苛临床核验；行政入职等低风险走敏捷通道&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="purview-agent365" value="&lt;b&gt;Agent 365 实名登记与 Purview 审计&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;强制绑定责任人、用途与运行花名册，全量留存交互提示词日志与异常遥测&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="dragon-ehr-endpoint" value="&lt;b&gt;诊室床旁窗口：Dragon Copilot + EHR&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;在环境语音病历录入同屏直接挂载 Copilot Studio 专科指南与核查智能体&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="teams-m365-endpoint" value="&lt;b&gt;行政与协同端点：Copilot App &amp;amp; Teams&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;面向行政、排班与新聘医师入职（Provider Onboarding）自动化减负提速&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="triple-outcomes" value="&lt;b&gt;医疗三大核心挑战闭环成效&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;缓解财务拒付压力（编码追问 43→13/百台）、缩短患者候诊周期、降低医生职业倦怠&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="e1" value="进阶为构建者" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="copilot-chat-base" target="clinician-studio"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="受控沙盒可见" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="clinician-studio" target="coe-sandbox-discovery"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="受控院内信源" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="foundry-iq" target="risk-tiered-gate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="双向提报扩规模" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="coe-sandbox-discovery" target="risk-tiered-gate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="高风险审批入床旁" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="risk-tiered-gate" target="dragon-ehr-endpoint"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="敏捷发布至办公端" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="risk-tiered-gate" target="teams-m365-endpoint"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="释放临床时间" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dragon-ehr-endpoint" target="triple-outcomes"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="持续日志与审计" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="purview-agent365" target="dragon-ehr-endpoint"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
