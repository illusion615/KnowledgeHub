<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="Azure Container Apps Sandboxes 零密钥安全边界与硬件隔离架构"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-entry-ingress-plane" value="1. 外部触发与入站治理层（沙盒边界之外 · Outside Sandbox Boundary）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="36" y="24" width="1368" height="190" as="geometry"/></mxCell><mxCell id="group-sandbox-group-plane" value="2. 区域管理边界：Sandbox Group 硬件隔离微虚拟机池（2M+ 日活实例）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="36" y="238" width="1368" height="190" as="geometry"/></mxCell><mxCell id="group-egress-storage-plane" value="3. 零密钥出站代理与跨生命周期存储连接层（Secretless Egress &amp; Durable State）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="36" y="452" width="1368" height="190" as="geometry"/></mxCell><mxCell id="dev-entry" value="&lt;b&gt;多模编排与研发入口&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Azure 门户 · ACA CLI · VS Code 远程终端 · Python/.NET SDK · Bicep&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="90" y="94" width="380" height="96" as="geometry"/></mxCell><mxCell id="ingress-proxy" value="&lt;b&gt;独立入站代理（Ingress Proxy）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;默认全关；按实例与端口显式开放，支持 Entra ID 认证与流量唤醒&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="530" y="94" width="380" height="96" as="geometry"/></mxCell><mxCell id="event-triggers" value="&lt;b&gt;托管事件触发器（Managed Triggers）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;监听连接器事件或网络请求，按需拉起休眠沙盒并注入执行命令&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="970" y="94" width="380" height="96" as="geometry"/></mxCell><mxCell id="microvm-runtime" value="&lt;b&gt;独立内核微虚拟机（ACA Sandbox）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;XS (0.25核/0.5GiB) 至 3XL (16核/32GiB)，&amp;lt;1 秒极速启动运行非受信代码&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="90" y="308" width="380" height="96" as="geometry"/></mxCell><mxCell id="custom-images" value="&lt;b&gt;月度官方底座与自定义磁盘镜像&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;支持 OCI 容器一键转根文件系统，预置专属依赖与智能体执行内核&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="530" y="308" width="380" height="96" as="geometry"/></mxCell><mxCell id="snapshot-engine" value="&lt;b&gt;内存+磁盘快照（Suspend / Resume）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;暂停即冻结完整运行上下文并释放算力，实现零空闲计费与断点续跑&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="970" y="308" width="380" height="96" as="geometry"/></mxCell><mxCell id="egress-proxy" value="&lt;b&gt;零密钥出站代理（Egress Proxy）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;默认全拒+域名白名单；通过 Transform 规则在沙盒外动态注入真实凭据&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="90" y="522" width="380" height="96" as="geometry"/></mxCell><mxCell id="mcp-connectors" value="&lt;b&gt;1,700+ 托管连接器与 Work IQ&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;群组级一次挂载，支持 Entra ID 代理用户授权（OBO）访问日程与业务系统&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="530" y="522" width="380" height="96" as="geometry"/></mxCell><mxCell id="durable-storage" value="&lt;b&gt;跨沙盒持久记忆存储与私有网络&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;托管磁盘、Blob 存储及私有 VNet 直连，沙盒销毁后长程记忆依然留存&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="970" y="522" width="380" height="96" as="geometry"/></mxCell><mxCell id="edge-1" value="声明式编排" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dev-entry" target="microvm-runtime"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-2" value="受控端口唤醒" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ingress-proxy" target="microvm-runtime"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-3" value="事件恢复执行" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="event-triggers" target="snapshot-engine"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-4" value="极速引导" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="custom-images" target="microvm-runtime"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-5" value="无凭据出站请求" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="microvm-runtime" target="egress-proxy"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-6" value="MCP 工具调用" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="microvm-runtime" target="mcp-connectors"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-7" value="状态持久化" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="snapshot-engine" target="durable-storage"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
