<mxfile host="Study-Room-Diagram-Engine" version="1"><diagram id="page-1" name="Copilot Studio D2E Streaming Gateway 系统架构"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-customer-domain" value="客户 / 第三方系统（方案边界外）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=16;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1520" height="192" as="geometry"/></mxCell><mxCell id="group-gateway-domain" value="Azure D2E Streaming Gateway（方案部署边界）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=16;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="244" width="1520" height="192" as="geometry"/></mxCell><mxCell id="group-microsoft-domain" value="Microsoft 平台域（边界外既有组件）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=16;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="464" width="1520" height="192" as="geometry"/></mxCell><mxCell id="customer-app" value="&lt;b&gt;客户自有应用&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Web / Mobile / Backend；携带项目选定凭据&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F2F7FB;strokeColor=#8FB5D2;strokeWidth=2;fontColor=#1E3A5F;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="660" y="96" width="280" height="96" as="geometry"/></mxCell><mxCell id="edge-api" value="&lt;b&gt;Azure API Management&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;可选统一入口：认证策略、限流；必须关闭 SSE 响应缓冲&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F8F4FC;strokeColor=#B9A3D5;strokeWidth=2;fontColor=#4C1D95;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="71" y="316" width="280" height="96" as="geometry"/></mxCell><mxCell id="conversation-runtime" value="&lt;b&gt;Streaming API Runtime&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;调用方访问控制、限流、取消与超时；归约与透传两种写出模式&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="366" y="316" width="280" height="96" as="geometry"/></mxCell><mxCell id="session-store" value="&lt;b&gt;会话状态存储&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;不透明 ID 映射上游 conversationId；ETag、TTL、turn 锁&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF9E8;strokeColor=#D4B266;strokeWidth=2;fontColor=#713F12;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="1249" y="316" width="280" height="96" as="geometry"/></mxCell><mxCell id="d2e-adapter" value="&lt;b&gt;D2E Streaming Adapter&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;单一帧读取路径：D2E POST、Activity SSE 解析、超时分类&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="660" y="316" width="280" height="96" as="geometry"/></mxCell><mxCell id="identity-cache" value="&lt;b&gt;专用 delegated 身份&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;专用用户账号 + 加密 MSAL cache（本机 mode 600 文件）&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="954" y="316" width="280" height="96" as="geometry"/></mxCell><mxCell id="entra-id" value="&lt;b&gt;Microsoft Entra ID&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;签发 delegated token；scope 为 api.powerplatform.com/.default&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F2F7FB;strokeColor=#8FB5D2;strokeWidth=2;fontColor=#1E3A5F;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="169" y="536" width="280" height="96" as="geometry"/></mxCell><mxCell id="d2e-runtime" value="&lt;b&gt;Power Platform D2E&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;校验 delegated 身份，返回 Activity SSE&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F2F7FB;strokeColor=#8FB5D2;strokeWidth=2;fontColor=#1E3A5F;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="660" y="536" width="280" height="96" as="geometry"/></mxCell><mxCell id="anonymous-agent" value="&lt;b&gt;已发布 No Authentication Agent&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;不要求最终用户 Entra 登录&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F2F7FB;strokeColor=#8FB5D2;strokeWidth=2;fontColor=#1E3A5F;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="1151" y="536" width="280" height="96" as="geometry"/></mxCell><mxCell id="edge-1" value="可选 APIM 路径" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=13;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="customer-app" target="edge-api"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-2" value="直连 HTTPS / SSE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=13;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="customer-app" target="conversation-runtime"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=13;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="edge-api" target="conversation-r