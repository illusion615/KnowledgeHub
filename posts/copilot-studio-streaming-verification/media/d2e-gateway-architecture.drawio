<mxfile host="Study-Room-Diagram-Engine" version="1"><diagram id="page-1" name="Copilot Studio D2E Streaming Gateway 系统架构"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-customer-domain" value="客户 / 第三方系统（方案边界外）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=16;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1520" height="182" as="geometry"/></mxCell><mxCell id="group-gateway-domain" value="Azure D2E Streaming Gateway（方案部署边界）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=16;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="234" width="1520" height="182" as="geometry"/></mxCell><mxCell id="group-microsoft-domain" value="Microsoft 平台域" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=16;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="444" width="1520" height="182" as="geometry"/></mxCell><mxCell id="customer-idp" value="&lt;b&gt;调用方访问控制&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;OIDC JWT / API key / mTLS；公网生产三选一&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF9E8;strokeColor=#D4B266;strokeWidth=2;fontColor=#713F12;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="292" y="96" width="280" height="86" as="geometry"/></mxCell><mxCell id="customer-app" value="&lt;b&gt;客户自有应用&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Web / Mobile / Backend；携带项目凭据&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F2F7FB;strokeColor=#8FB5D2;strokeWidth=2;fontColor=#1E3A5F;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeom