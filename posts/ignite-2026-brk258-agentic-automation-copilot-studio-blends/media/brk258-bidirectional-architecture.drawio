<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="BRK258 智能体自动化双向编排拓扑：确定性工作流与推理智能体的混合架构"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-entry-layer" value="1. 三路创作与触发入口层（Designer · Copilot Cowork · Copilot Studio MCP）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="44" y="40" width="992" height="186" as="geometry"/></mxCell><mxCell id="group-blend-layer" value="2. 双向混合编排核心层（五类智能节点 vs 工作流作为工具）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="44" y="260" width="992" height="186" as="geometry"/></mxCell><mxCell id="group-scale-layer" value="3. 企业级执行与规模治理层（1,500+ 连接器 · 服务主体 · 逐动作账本）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="44" y="480" width="992" height="186" as="geometry"/></mxCell><mxCell id="visual-canvas" value="&lt;b&gt;自由画布工作流设计器 (GA)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;横纵一键切换 · 单节点就地测试 · 小地图与 JSON 视图&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="79" y="112" width="292" height="90" as="geometry"/></mxCell><mxCell id="cowork-skill" value="&lt;b&gt;Copilot Cowork 自然语言构建&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;挂载 Work IQ 团队脉络 · 一句话联产工作流与智能体&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="394" y="112" width="292" height="90" as="geometry"/></mxCell><mxCell id="mcp-cli" value="&lt;b&gt;Copilot Studio MCP 服务 (GA)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;VS Code / Codex / Claude Code 直连创建与运行测试&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="709" y="112" width="292" height="90" as="geometry"/></mxCell><mxCell id="classify-extract" value="&lt;b&gt;Classify (0.06s) 与 Extract 节点&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Decision 模型快 35× 省 200× + 置信度 · 脏扫票据结构化&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="79" y="332" width="292" height="90" as="geometry"/></mxCell><mxCell id="agent-copilot-code" value="&lt;b&gt;Agent / Copilot / Python Code 节点&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;行内或复用代理 · 真实文件输出 (.pdf/.xlsx) · 原生 Python&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="394" y="332" width="292" height="90" as="geometry"/></mxCell><mxCell id="workflow-as-tool" value="&lt;b&gt;反向挂载：工作流作为智能体工具&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;智能体自主决策何时调用 · 工作流锁死合规步骤序列&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="709" y="332" width="292" height="90" as="geometry"/></mxCell><mxCell id="det-connectors" value="&lt;b&gt;确定性动作与人工审批挂起&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;1,500+ 连接器 (0.13 Cr/步) · Teams/邮件挂起等待审批&lt;/font&gt;" st