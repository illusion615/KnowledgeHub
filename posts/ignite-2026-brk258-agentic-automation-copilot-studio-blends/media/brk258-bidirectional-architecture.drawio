" edge="1" parent="1" source="mcp-cli" target="workflow-as-tool"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-4" value="&lt;85% 转人工" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="classify-extract" target="det-connectors"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-5" value="文件与数据传递" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="agent-copilot-code" target="alm-spn-env"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-6" value="审计追踪" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="workflow-as-tool" target="credit-observability"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
