<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="Microsoft Plugin Registry：一次治理、全域复用的三层扩展与控制架构（BRK221）"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-build-pkg-plane" value="1. 组合构建与打包层（Plugin Packaging &amp; Work IQ Developer Tools）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1440" height="190" as="geometry"/></mxCell><mxCell id="group-registry-gov-plane" value="2. 单一注册表与集中治理层（Microsoft Plugin Registry + Agent 365）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="238" width="1440" height="190" as="geometry"/></mxCell><mxCell id="group-surfaces-plane" value="3. 全入口工作流即插即用层（Use Everywhere Across Copilot &amp; M365）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="452" width="1440" height="190" as="geometry"/></mxCell><mxCell id="tools-mcp" value="&lt;b&gt;Tools：MCP 服务与连接器（What）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;连接核心业务系统（如 Caldova / Dynamics 365）的确定性输入输出操作&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="skills-agents" value="&lt;b&gt;Skills 技能与 Agents 智能体（How）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;封装自然语言规范（如高管 Excel 模板、社媒裁切规格）指导智能体编排&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="wiqd-cli" value="&lt;b&gt;Work IQ Developer Tools（WIQD CLI）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;在 GitHub Copilot 内闭环构建、manifest.json 校验、预览、评测与提审&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="plugin-catalog" value="&lt;b&gt;统一插件注册表（350+ 伙伴与自研）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;汇聚微软官方、Adobe/Asana 等超 350 款生态插件、自研包与共享单技能包&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="a365-approval" value="&lt;b&gt;Agent 365 准入审批与受众分发&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;M365 管理中心审查版本与远端 MCP 工具；按部门组一键预装或随时封禁&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="usage-telemetry" value="&lt;b&gt;30 天调用洞察与异常监控&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;按插件与 MCP 端点追踪调用峰值、关联智能体清单与异常报错次数&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="copilot-home-cowork" value="&lt;b&gt;Copilot Home（Chat 与 Cowork）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;结合 Work IQ 上下文渲染交互式 MCP App 门禁微件，支持对话内沉淀新技能&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="code-autopilot" value="&lt;b&gt;Copilot Code · Autopilot · Studio&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;跨研发编码态、后台自主任务与业务流程编排无缝复用同一受控插件包&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="m365-office-apps" value="&lt;b&gt;Word · Excel · PowerPoint · SharePoint&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;免切出文档窗口，直接拉取同源门禁数据生成高管报表与脱敏白皮书 PDF&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="e1" value="声明端点" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tools-mcp" target="plugin-catalog"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="封装技能" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="skills-agents" target="plugin-catalog"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="校验并提审" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="wiqd-cli" target="a365-approval"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="按需启用" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="plugin-catalog" target="copilot-home-cowork"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="一次审批" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="a365-approval" target="code-autopilot"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="按组预装" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="a365-approval" target="m365-office-apps"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="回传遥测与新技能" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="copilot-home-cowork" target="usage-telemetry"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
