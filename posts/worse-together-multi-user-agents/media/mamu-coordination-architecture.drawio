<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="MAMUBench 多用户多智能体资源竞争、失灵机理与跨栈缓解架构"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-formation-plane" value="1. 四类编队实验对照与稀缺共享资源（Formations &amp; Contested Shared Resources）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1440" height="192" as="geometry"/></mxCell><mxCell id="group-failure-plane" value="2. 一人一代理团队的三大典型失灵机理（Peer-to-Peer Failure Taxonomy）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="1440" height="192" as="geometry"/></mxCell><mxCell id="group-mitigation-plane" value="3. 对症下药的跨栈治理与评测防线（Environment-Specific Stack Mitigations）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="456" width="1440" height="192" as="geometry"/></mxCell><mxCell id="coordinator-ctrl" value="&lt;b&gt;单智能体协调器（Coordinator 对照组）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;单一上下文汇总全员目标与截止期，四大环境领先团队 10–45 个百分点&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="94" width="320" height="98" as="geometry"/></mxCell><mxCell id="p2p-silent-teams" value="&lt;b&gt;一人一代理团队（Silent / P2P Team）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;独立上下文各为其主；无通信静默组在两类环境中崩溃，有私信仍严重折损&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="94" width="320" height="98" as="geometry"/></mxCell><mxCell id="contested-resources" value="&lt;b&gt;四类受限共享资源池（4 Environments）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;API 词元预算、门诊满额日历、共享拼单/差旅预算与发版前 CI 合并队列&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="94" width="320" height="98" as="geometry"/></mxCell><mxCell id="stalling-interference" value="&lt;b&gt;规模性观望瘫痪与未经同意砍单&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;4→16 人时 Sonnet 行动率从 66% 跌至 10%；部分模型每局擅砍他人任务 3.9–7.1 次&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="310" width="320" height="98" as="geometry"/></mxCell><mxCell id="race-overrides" value="&lt;b&gt;未读消息抢跑提交与购物车覆写&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;94%–99% 诉求已发出但结账时仅 47%–67% 进上下文；65%–77% 对局发生逆向篡改&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="310" width="320" height="98" as="geometry"/></mxCell><mxCell id="info-fabrications" value="&lt;b&gt;局部视野脑补捏造与消极推诿&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;53%–58% 团队局凭空编造他人偏好（单代理仅 17%–20%）；门诊转候补错失急诊期&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="310" width="320" height="98" as="geometry"/></mxCell><mxCell id="lead-priority" value="&lt;b&gt;价值排序领队（Team Lead + Priority）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;算力池按价值排优并释放尾盘预算反超协调器（71% vs 64%）；合并队列达 97%&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="526" width="320" height="98" as="geometry"/></mxCell><mxCell id="mcp-unread-guard" value="&lt;b&gt;平台级未读消息结账门禁（MCP Guard）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;服务端强制读完待处理私信才放行结账，挽救 73.1%（Opus）与 62.3%（Sonnet）失败单&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="526" width="320" height="98" as="geometry"/></mxCell><mxCell id="sop-dual-eval" value="&lt;b&gt;严格执业规程与「结果×行为」双维评测&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;门诊禁推诿规程助团队升至 95.3%/91.8%；联合审计群体效用与越权/捏造行为&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="526" width="320" height="98" as="geometry"/></mxCell><mxCell id="edge-1" value="全局视角规避内耗" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="coordinator-ctrl" target="stalling-interference"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-2" value="异步私信引发竞态" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p2p-silent-teams" target="race-overrides"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-3" value="信息割裂诱发脑补" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="contested-resources" target="info-fabrications"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-4" value="确立裁决与优先级" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="stalling-interference" target="lead-priority"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-5" value="服务端阻塞早退提交" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="race-overrides" target="mcp-unread-guard"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-6" value="硬性规程与双轨审计" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="info-fabrications" target="sop-dual-eval"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
