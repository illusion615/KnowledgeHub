<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="企业智能体信任架构：四大安全与治理控制面（THR994 · Bontoso 实战）"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-agent-build-plane" value="1. 创作与运行护栏层（Copilot Studio + 企业知识与操作边界）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1440" height="190" as="geometry"/></mxCell><mxCell id="group-security-lenses-plane" value="2. 身份、数据与威胁三大防御透镜（Entra + Purview + Defender）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="238" width="1440" height="190" as="geometry"/></mxCell><mxCell id="group-fleet-control-plane" value="3. 全域编目与生命周期控制面（Microsoft Agent 365 in M365 Admin Center）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="452" width="1440" height="190" as="geometry"/></mxCell><mxCell id="copilot-studio-agent" value="&lt;b&gt;Bontoso HR Helper Standard（v1.0.4）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Copilot Studio 构建发布至 Teams / Chat，启用 Microsoft 身份认证与安全扫描&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="sharepoint-knowledge" value="&lt;b&gt;SharePoint HR Hub（过度共享技术债）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;存放育儿假规章与高度机密的 2027 薪酬职级表（Everyone 历史宽泛权限）&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="delegated-tools" value="&lt;b&gt;委托工具操作（2 项受控能力）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;search_sharepoint_onedrive 检索 + SharePoint Create item 经用户确认代写休假单&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="entra-agent-id" value="&lt;b&gt;Microsoft Entra：专属身份与责任人&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;分离员工与智能体身份；绑定人类责任人、条件访问策略与限时访问包&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="purview-dspm-dlp" value="&lt;b&gt;Microsoft Purview：标签防泄漏与审计&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;拦截高度机密文档进入 Copilot 处理流；DSPM 监测 Top 20 智能体与 638 条交互审计&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="defender-posture" value="&lt;b&gt;Microsoft Defender：攻击面与 KQL 狩猎&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;透视工具/MCP 攻击面与风险评级；通过 AgentsInfo 表关联身份与安全告警&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="a365-observe" value="&lt;b&gt;全域观测（Observe：All Agents &amp;amp; Map）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;在 M365 管理中心盘点全量智能体、渠道分布、系统指令与影子 AI 资产&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="a365-govern" value="&lt;b&gt;准入治理（Govern：Owners &amp;amp; Rules）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;核验创建者/所有者归属（A-Minnie Bontoso）、受权用户范围与共享审批策略&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="a365-secure" value="&lt;b&gt;闭环联防（Secure：Zero Trust Enforcement）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;联动 Entra 禁用失管身份、Purview 收敛过度共享、Defender 阻断目标劫持（ASI01–03）&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="e1" value="签发 Entra Agent ID" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="copilot-studio-agent" target="entra-agent-id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="敏感度标签与 DLP 拦截" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sharepoint-knowledge" target="purview-dspm-dlp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="工具与 MCP 攻击面测绘" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="delegated-tools" target="defender-posture"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="同步责任人与条件访问" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="entra-agent-id" target="a365-govern"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="汇聚 30 天 AI 交互洞察" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="purview-dspm-dlp" target="a365-observe"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="推送风险与狩猎告警" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="defender-posture" target="a365-secure"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
