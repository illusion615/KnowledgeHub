<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="金融机构智能体分层治理与生产运行时架构（BRK473）"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-maker-green-zone" value="1. 创作者绿区（Green Zone）：环境自动路由与内嵌合规引导（State Farm 阶梯起点）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1420" height="188" as="geometry"/></mxCell><mxCell id="group-managed-runtime-plane" value="2. 生产托管运行时与自动化晋升面（Managed Host · Shrink-Wrap Governance）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="236" width="1420" height="188" as="geometry"/></mxCell><mxCell id="group-agentic-finops-plane" value="3. 双中心成本控制与智能体管理底座（OpenAPI 单一规范 · PAC CLI + Cowork）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="448" width="1420" height="188" as="geometry"/></mxCell><mxCell id="env-routing" value="&lt;b&gt;环境自动路由与环境组（~50 规则）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;告别拥挤默认环境，按需派生个人开发孤岛并归入环境组统一纳管&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="134" y="94" width="318" height="94" as="geometry"/></mxCell><mxCell id="sql-oauth-acp" value="&lt;b&gt;高级连接器策略（SQL 仅限 OAuth）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;在 1,500+ 连接器中精确放行特定动作，强制 OAuth 鉴权并禁用明文库连接&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="591" y="94" width="318" height="94" as="geometry"/></mxCell><mxCell id="studio-advisor" value="&lt;b&gt;欢迎词确认与状态栏智能体向导&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;首登必读合规条款，被策略拦截时直接在状态栏唤起 IT 异常申请智能体&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1048" y="94" width="318" height="94" as="geometry"/></mxCell><mxCell id="vec-alm-pipeline" value="&lt;b&gt;虚拟环境集群（VEC）与无感流水线&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;结合 Git 源码备份与自动化流水线，将成熟资产推入最小权限生产目标&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="134" y="306" width="318" height="94" as="geometry"/></mxCell><mxCell id="managed-host-csp" value="&lt;b&gt;托管主机（Entra 鉴权 + CSP 强拦截）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;即使外部 CLI 构建的纯代码应用，运行态也会实时阻断未授权外部 API 调用&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="591" y="306" width="318" height="94" as="geometry"/></mxCell><mxCell id="monitor-alerts" value="&lt;b&gt;Purview 审计与 1 小时级健康告警&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;原生采集运行遥测，支持小时级异常退化订阅并直推 Teams 或 ServiceNow&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1048" y="306" width="318" height="94" as="geometry"/></mxCell><mxCell id="inventory-50s" value="&lt;b&gt;全域资产清单（250 万资产 50 秒刷新）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;实时透视智能体所用底层线束（Copilot Harness）与具体模型分布&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="134" y="518" width="318" height="94" as="geometry"/></mxCell><mxCell id="usl-mac-credits" value="&lt;b&gt;PPAC 坐席许可 + MAC 四级点数治理&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;区分固定月费基础用度与按量计费点数，工作台左上角实时回显消耗&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="591" y="518" width="318" height="94" as="geometry"/></mxCell><mxCell id="openapi-cowork-cli" value="&lt;b&gt;单一 OpenAPI 规范（PAC CLI + Cowork）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;月度同步生成 15 个 CLI 命令组与插件，约 10 美元 30 分钟构建 360 管控台&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1048" y="518" width="318" height="94" as="geometry"/></mxCell><mxCell id="edge-1" value="注入组策略" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="env-routing" target="sql-oauth-acp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-2" value="合规评估晋升" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sql-oauth-acp" target="vec-alm-pipeline"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-3" value="引导转正" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="studio-advisor" target="vec-alm-pipeline"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-4" value="部署受控目标" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="vec-alm-pipeline" target="managed-host-csp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-5" value="原生运行遥测" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="managed-host-csp" target="monitor-alerts"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-6" value="50 秒增量同步" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="managed-host-csp" target="inventory-50s"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-7" value="API 开放订阅" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="monitor-alerts" target="openapi-cowork-cli"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-8" value="周报与隔离执行" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="usl-mac-credits" target="openapi-cowork-cli"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
