<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="Microsoft Copilot Harness 运行时闭环与五大构建模块架构（THR964）"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-maker-design-plane" value="1. 制作者声明与按需加载设计层（Maker Design Plane: Instructions, Skills &amp; Grounding）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1440" height="190" as="geometry"/></mxCell><mxCell id="group-harness-runtime-plane" value="2. Microsoft Copilot Harness 运行时编排内核（Plan · Act · Evaluate &amp; Re-Plan Loop）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="238" width="1440" height="190" as="geometry"/></mxCell><mxCell id="group-execution-action-plane" value="3. 混合执行、沙盒运算与多渠道发布层（Tools, Deterministic Workflows &amp; Python Sandbox）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="452" width="1440" height="190" as="geometry"/></mxCell><mxCell id="concise-instructions" value="&lt;b&gt;Instructions：目标、语气与禁区边界&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;仅保留全局恒定规则与拒绝越界声明，免除冗长排障脚本常驻上下文&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="dynamic-skills" value="&lt;b&gt;Skills：按需加载的领域流程（上限 50 个）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;以 Markdown 描述触发时机与分步规程，可附带模板资源包与 Python 脚本&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="workiq-knowledge" value="&lt;b&gt;Work IQ 与受控白名单外部知识源&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;默认连接 SharePoint/OneDrive/Teams/Outlook，支持按域读写收窄与站点白名单&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="context-selector" value="&lt;b&gt;01–02 调用裁决与最小上下文装配&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;每轮决定何时调用模型，仅抽取与当前复合意图相关的技能与知识片段&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="multi-model-brain" value="&lt;b&gt;多模型推理大脑（GPT 与 Anthropic 实例）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;拆解“蓝屏排障 + 申请新笔记本”等复合请求，动态生成有序多步执行计划&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="eval-replan-loop" value="&lt;b&gt;03–04 结果自检与异常重规划闭环&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;核验返回结果是否满足终端诉求；遇工具报错或结果偏离时自动改写计划恢复&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="connectors-mcp" value="&lt;b&gt;Tools：连接器生态与 MCP 服务端点&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;动态匹配并调用业务数据库与第三方系统增删改查接口，免手工硬编码触发语&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="deterministic-workflows" value="&lt;b&gt;Workflows：确定性多步合规流双向互调&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;智能体与固定顺序工作流按需互调，锁死设备四年换新窗口核验与工单审批&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="python-sandbox" value="&lt;b&gt;Sandbox 安全代码沙盒与全渠道发布&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;内置隔离环境运行 Python 产出图表与 PPTX；经 Evaluate 单测后发布至 Teams/Web&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="e1" value="全局边界" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="concise-instructions" target="context-selector"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="按需挂载" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dynamic-skills" target="context-selector"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="受控检索" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="workiq-knowledge" target="multi-model-brain"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="装配提示" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="context-selector" target="multi-model-brain"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="解析与验证" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="multi-model-brain" target="eval-replan-loop"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="精准调工具" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="eval-replan-loop" target="connectors-mcp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="交接固定流" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="eval-replan-loop" target="deterministic-workflows"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="执行代码" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="eval-replan-loop" target="python-sandbox"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="未达标重规划" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="eval-replan-loop" target="context-selector"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
