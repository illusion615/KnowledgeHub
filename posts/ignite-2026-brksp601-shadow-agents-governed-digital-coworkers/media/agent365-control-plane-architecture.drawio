<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="Agent 365 全域控制平面：三条接入轨道与四大企业安全视图"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-intake-layer" value="1. 三条智能体注册接入轨道（Three Paths into Agent 365 Registry）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="44" y="40" width="1152" height="188" as="geometry"/></mxCell><mxCell id="group-identity-core" value="2. 统一身份与蓝图继承内核（Blueprint 1:N · One Agent, One Identity）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="44" y="262" width="1152" height="188" as="geometry"/></mxCell><mxCell id="group-control-views" value="3. 四大企业管控平面与三方角色分治（Admin · Identity · Compliance · SecOps）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="44" y="484" width="1152" height="188" as="geometry"/></mxCell><mxCell id="ms-native" value="&lt;b&gt;微软原生平台（自动同步）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Copilot Studio · Foundry · SharePoint 未发布亦纳管&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="134" y="112" width="236" height="92" as="geometry"/></mxCell><mxCell id="connected-cloud" value="&lt;b&gt;外部连接平台（注册表同步）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Amazon Bedrock · Vertex AI · Snowflake · Databricks&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="502" y="112" width="236" height="92" as="geometry"/></mxCell><mxCell id="dev-sdk" value="&lt;b&gt;自研代码智能体（SDK 接入）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Python / OpenAI SDK / LangChain 免重写纳管&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="870" y="112" width="236" height="92" as="geometry"/></mxCell><mxCell id="agent-blueprint" value="&lt;b&gt;智能体蓝图（Agent Blueprint）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;集中托管联合凭据、认证策略与继承权限，消除千份密钥&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="226" y="334" width="236" height="92" as="geometry"/></mxCell><mxCell id="agent-identity" value="&lt;b&gt;独立身份与数字工牌（Entra Agent ID）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;绑定技术 Owner + 业务 Sponsor · 独立邮箱与 Teams 状态&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="778" y="334" width="236" height="92" as="geometry"/></mxCell><mxCell id="m365-admin" value="&lt;b&gt;M365 管理中心（全局盘点）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;跨环境清点指令/工具/活跃用户 · 一键冻结或转交&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="88" y="556" width="236" height="92" as="geometry"/></mxCell><mxCell id="entra-gov" value="&lt;b&gt;Microsoft Entra（访问与周期）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;高风险条件访问阻断 · 月度限时访问包 · 离职自动继任&lt;/font&gt;" styl