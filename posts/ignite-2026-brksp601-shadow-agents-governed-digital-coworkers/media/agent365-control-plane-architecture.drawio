undColor=#FFFFFF;" edge="1" parent="1" source="dev-sdk" target="agent-blueprint"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-4" value="1:N 派生无密实例" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="agent-blueprint" target="agent-identity"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-5" value="资产台账" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="agent-identity" target="m365-admin"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-6" value="策略靶向" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="agent-identity" target="entra-gov"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-7" value="内容合规" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="agent-identity" target="purview-dlp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-8" value="行为遥测" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="agent-identity" target="defender-sec"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
