<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="智能体权限跃迁与六步发布治理架构（THR1004 · 采购助手实战）"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-authority-jump-plane" value="1. 权限跃迁边界与发布记录（Step 1 Identify + Step 2 Describe）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1440" height="190" as="geometry"/></mxCell><mxCell id="group-microsoft-boundary-plane" value="2. 平台原生边界控制面（Step 3 Configure + Step 4 Test）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="238" width="1440" height="190" as="geometry"/></mxCell><mxCell id="group-release-decision-plane" value="3. 流水线晋级、核验与周一裁决（Step 5 Promote + Step 6 Verify）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="452" width="1440" height="190" as="geometry"/></mxCell><mxCell id="baseline-readonly" value="&lt;b&gt;辅助型基线（Version 1 只读状态）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;仅读取 DEMO-101~103 采购单状态；仅需 Agent 365 台账登记与实名负责人&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="proposed-transactional" value="&lt;b&gt;交易型跃迁（创建与提交采购申请）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;新增工具、凭据与目标系统写权限；激活独立《智能体发布记录》&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="excluded-consequential" value="&lt;b&gt;后果型禁区（排除审批支出与付款）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;涉及资金划拨与法律承诺；列入严禁越界清单，若开放须高管实名签批&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="ppac-entra-boundary" value="&lt;b&gt;Power Platform + Entra：连接器与凭据&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;单环境策略阻断越界 HTTP 调用（原生 403 Forbidden），核验跨边界提交身份&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="purview-sam-evidence" value="&lt;b&gt;Purview + SAM：标签防泄漏与审计&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;DSPM 摸底敏感数据触达，延续敏感度标签/DLP 并留存取证级交互流水&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="copilot-studio-eval" value="&lt;b&gt;Copilot Studio + Foundry：正反例评测&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;穿透通用质量假阴性（1/3），按业务意图核验未知单号与越权拒答（3/3 合规）&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="pipeline-receipt" value="&lt;b&gt;流水线晋级回执（Succeeded v1.0.0.1）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;部署回执仅证明构建包已送达目标环境，不代表新动作已完成生产授权核验&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="two-names-one-number" value="&lt;b&gt;放行铁律：两个实名 + 一个业务指标&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;日常负责人（Owner）+ 风险签批人（Approver）+ 单笔耗时指标缺一即暂缓&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="ship-hold-contain" value="&lt;b&gt;三态裁决：SHIP / HOLD / CONTAIN&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;证据闭环则放行；提交运行时未证则暂缓（HOLD）；越界异动则按路径隔离&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="e1" value="盘点基线与环境范围" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="baseline-readonly" target="ppac-entra-boundary"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="映射写权限与数据边界" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proposed-transactional" target="purview-sam-evidence"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="注入审批付款负例测试" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="excluded-consequential" target="copilot-studio-eval"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="留存 403 阻断与重测证据" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ppac-entra-boundary" target="pipeline-receipt"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="支撑合规审计与风险签批" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="purview-sam-evidence" target="two-names-one-number"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="判定 HOLD 未证实运行时" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="copilot-studio-eval" target="ship-hold-contain"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
