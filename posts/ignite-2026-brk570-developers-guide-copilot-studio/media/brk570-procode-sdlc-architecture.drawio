<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="BRK570 专业代码与业务协同双循环架构（msagent CLI · Git SDLC · Copilot Studio）"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-local-procode" value="1. 本地开发者内循环（终端 CLI · 编程代理 · VS Code 语言服务器）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="44" y="40" width="992" height="184" as="geometry"/></mxCell><mxCell id="group-filesystem-git" value="2. 文件化智能体工程与标准 Git 软件交付流水线（单一事实源）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="44" y="258" width="992" height="184" as="geometry"/></mxCell><mxCell id="group-managed-runtime" value="3. Copilot 托管运行时与多角色协同治理层（Dev / Test / Prod）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="44" y="476" width="992" height="184" as="geometry"/></mxCell><mxCell id="coding-agents" value="&lt;b&gt;任意终端编程智能体&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;实测兼容 GitHub Copilot、Claude Code 与 Gemini CLI&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="75" y="112" width="300" height="88" as="geometry"/></mxCell><mxCell id="msagent-cli" value="&lt;b&gt;msagent CLI 开发者命令行&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;create / show / deploy / ask --json 与离线评测执行&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="390" y="112" width="300" height="88" as="geometry"/></mxCell><mxCell id="vscode-lsp" value="&lt;b&gt;VS Code 扩展与语言服务器&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;连接引用重绑、工作流拓扑预览与 Peek Remote 对比&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="705" y="112" width="300" height="88" as="geometry"/></mxCell><mxCell id="file-schema" value="&lt;b&gt;透明本地文件系统结构&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;agent.config.json · *.mcs.yml · SKILL.md + Python 脚本&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="75" y="330" width="300" height="88" as="geometry"/></mxCell><mxCell id="git-pr-gate" value="&lt;b&gt;GitHub / Azure DevOps PR 门禁&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;分支策略、AI 自动摘要与按企业规则审查 YAML 变更&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="390" y="330" width="300" height="88" as="geometry"/></mxCell><mxCell id="custom-connectors" value="&lt;b&gt;自定义连接器与 MCP 工具集&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;封装 1990 年代遗留政务 API（如 FAA NOTAM / 气象服务）&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="705" y="330" width="300" height="88" as="geometry"/></mxCell><mxCell id="copilot-harness" value="&lt;b&gt;Microsoft Copilot Harness 运行时&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;多环境部署映射，同步发布至 Teams 与 M365 Copilot&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="75" y="548" width="300" height="88" as="geometry"/></mxCell><mxCell id="business-handoff" value="&lt;b&gt;业务负责人无代码画布接力&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;网页端微调模型（Astra 6.2 → Auto）并双向同步回 Git&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="390" y="548" width="300" height="88" as="geometry"/></mxCell><mxCell id="pac-governance" value="&lt;b&gt;PAC 管理侧与会话级成本监控&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;追踪客户端来源、交互耗时与点数账单（$0.01–$5 实测）&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="705" y="548" width="300" height="88" as="geometry"/></mxCell><mxCell id="edge-1" value="编排 CLI 命令" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="coding-agents" target="msagent-cli"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-2" value="克隆 / 生成文件" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="msagent-cli" target="file-schema"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-3" value="拉取远端差异提交" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="vscode-lsp" target="git-pr-gate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-4" value="msagent deploy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="file-schema" target="copilot-harness"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-5" value="多环境晋级发布" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="git-pr-gate" target="business-handoff"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-6" value="连接鉴权与审计" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="custom-connectors" target="pac-governance"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
