<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="BRK386 全栈架构：MCP 混合共创与 Work IQ 业务应用智能中枢"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-authoring-audiences" value="1. 三类角色与混合共创入口层（专业开发 BYOA · 低代码创作者 · M365 终端用户）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="44" y="40" width="992" height="188" as="geometry"/></mxCell><mxCell id="group-mcp-core-assets" value="2. MCP 服务桥接与核心平台资产层（同一可编辑解决方案 · 零词元可视化与代理共创）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="44" y="262" width="992" height="188" as="geometry"/></mxCell><mxCell id="group-workiq-collab" value="3. Work IQ 业务上下文与双向智能协同层（身份与权限随行 · 两阶段安全写回）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="44" y="484" width="992" height="188" as="geometry"/></mxCell><mxCell id="prodev-byoa" value="&lt;b&gt;专业开发者（VS Code / BYOA）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;自带 Claude / Mistral 等模型 · CLI + PowerCAT 性能技能&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="79" y="112" width="292" height="92" as="geometry"/></mxCell><mxCell id="studio-makers" value="&lt;b&gt;低代码创作者（统一 Make 门户）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;零词元拖拽微调 · 编码代理实时加入多人共创会话&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="394" y="112" width="292" height="92" as="geometry"/></mxCell><mxCell id="m365-users" value="&lt;b&gt;业务人员（Copilot 与 Cowork）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;意图驱动构建 · 分屏实时预览纠正与按需消耗额度&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="709" y="112" width="292" height="92" as="geometry"/></mxCell><mxCell id="mcp-harness" value="&lt;b&gt;四路 MCP 服务器与技能底座&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;性能巡检 (81 控件诊断) · 无障碍与安全审计 · 流程排障&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="79" y="334" width="292" height="92" as="geometry"/></mxCell><mxCell id="apps-estate" value="&lt;b&gt;Canvas / Model / Native 移动与代码应用&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;移动端启动快 55% · 6 款原生控件 (&amp;lt;1s 扫码) · 服务端渲染&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="394" y="334" width="292" height="92" as="geometry"/></mxCell><mxCell id="flows-pages" value="&lt;b&gt;云端流 / RPA 桌面流 / 挖掘 / Pages&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;确定性业务规则 · 触发器与连接器 · 下游变更自动诊断&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="709" y="334" width="292" height="92" as="geometry"/></mxCell><mxCell id="copilot-in-apps" value="&lt;b&gt;应用内 Copilot 侧栏（Model &amp;amp; Canvas GA）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;按屏幕定制零触控提示 · 声明式代理 · 自适应卡片双向跳转&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="79" y="556" width="292" height="92" as="geometry"/></mxCell><mxCell id="workiq-hub" value="&lt;b&gt;Work IQ 业务应用治理中枢&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;自动发现授权应用表与关系 · 严格继承用户角色与业务规则&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="394" y="556" width="292" height="92" as="geometry"/></mxCell><mxCell id="external-agents" value="&lt;b&gt;Cowork / Copilot Studio / 自治代理&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;跨应用检索未确认议程 · 两阶段预览确认后安全提交写回&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="709" y="556" width="292" height="92" as="geometry"/></mxCell><mxCell id="edge-1" value="MCP / CLI 接入" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="prodev-byoa" target="mcp-harness"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-2" value="拖拽 + 共创" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="studio-makers" target="apps-estate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-3" value="自然语言编排" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBa