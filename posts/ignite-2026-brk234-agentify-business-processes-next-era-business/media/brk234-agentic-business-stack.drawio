<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="BRK234 智能体化业务应用三层持久架构栈（Copilot · Microsoft IQ · Agent 365）"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-ux-frontdoor" value="1. 体验层：无头业务前门与自研资产（Copilot · Custom Agents · Managed Apps）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="44" y="40" width="992" height="184" as="geometry"/></mxCell><mxCell id="group-iq-data-layer" value="2. 智能上下文与业务数据层：Microsoft IQ 统一底座（M365 · Dynamics 365 · Fabric）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="44" y="258" width="992" height="184" as="geometry"/></mxCell><mxCell id="group-governance-control" value="3. 全域治理与运行时控制面（Agent 365 · Copilot Managed Runtime）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="44" y="476" width="992" height="184" as="geometry"/></mxCell><mxCell id="copilot-ux" value="&lt;b&gt;Copilot 无头工作台&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Today 管线看板 · Cowork 画布 · Autopilot 例行任务&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="77" y="112" width="296" height="88" as="geometry"/></mxCell><mxCell id="studio-trinity" value="&lt;b&gt;自研智能体与确定性流&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;GPU 推理判别 + CPU 确定性审批 · ~50% 词元节降&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=