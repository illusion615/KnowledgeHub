<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="BRK261 数字队友三支柱与企业级治理全景架构"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-collaborate-plane" value="1. 像同事一样协同（Collaborates Like a Colleague · Agent Accounts）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1440" height="190" as="geometry"/></mxCell><mxCell id="group-equipped-plane" value="2. 像员工一样装备（Equipped Like an Employee · Plugins, CUA &amp; MCP Apps）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="238" width="1440" height="190" as="geometry"/></mxCell><mxCell id="group-learn-govern-plane" value="3. 在岗进化与员工级治理（Learns on the Job &amp; User-Grade Governance）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="452" width="1440" height="190" as="geometry"/></mxCell><mxCell id="agent-account" value="&lt;b&gt;专属智能体账号（Agent Account）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;独立 Entra ID、专属邮箱与日历、组织架构汇报给经理 Vid&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="m365-surfaces" value="&lt;b&gt;全场景原生办公入口（M365 Surfaces）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Teams 频道与私聊、Outlook 邮件收发、Word/PPT/Excel 评论 @提及&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="proactive-triggers" value="&lt;b&gt;主动事件与定时触发（Always-On）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;每日晨会倒计时自动播报、SharePoint 变更监听与多团队协同通知&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="skills-plugins" value="&lt;b&gt;共享技能与统一插件包（Plugins）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;将团队 SOP 编码为 SKILL.md，聚合知识+工具+技能跨智能体复用&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="computer-use" value="&lt;b&gt;计算机使用智能体（Computer Use）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;云浏览器填报法务表单，Windows 365 云电脑操作无接口 Java 采购桌面端&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="sor-mcp-apps" value="&lt;b&gt;记录系统与富交互微件（MCP Apps）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;以智能体自身身份读写 Dataverse 台账，对话内直出交互式地图与日历&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="process-memory" value="&lt;b&gt;可视化共享记忆账本（Memory GA）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;沉淀个人偏好、跨轮次任务进度（CE-10033）与团队提速规程，支持随时审删&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="entra-purview" value="&lt;b&gt;身份访问与敏感度防泄漏（Security）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Agent Users 条件访问策略、敏感度标签隔离、禁删级最小权限与连接图谱&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="credit-finops" value="&lt;b&gt;三级算力成本围栏（Spend Control）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;单次会话点数透视、单智能体 100% 触顶熔断、环境级配额封顶禁抽租户池&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="edge-1" value="装载团队规程" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="agent-account" target="skills-plugins"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-2" value="委派无接口任务" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m365-surfaces" target="computer-use"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-3" value="同步核心台账" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proactive-triggers" target="sor-mcp-apps"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-4" value="写回经验与状态" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="skills-plugins" target="process-memory"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-5" value="条件访问与审计" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="computer-use" target="entra-purview"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-6" value="点数计量与封顶" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sor-mcp-apps" target="credit-finops"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
