<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="企业级社区驱动 Copilot Studio 规模化采纳飞轮（THR1021 官方框架）"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-foundation-skilling-plane" value="1. 使命基石与三阶创作者培育层（Foundation: Build + Training: Learn）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1440" height="190" as="geometry"/></mxCell><mxCell id="group-operation-engine-plane" value="2. 日常运营引擎与原生平台协同层（Operation: Run — The Engine After the Spark）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="238" width="1440" height="190" as="geometry"/></mxCell><mxCell id="group-partners-recognition-plane" value="3. 四维伙伴联盟与四阶荣誉晋升飞轮（Partners: Connect + Recognition: Celebrate）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="452" width="1440" height="190" as="geometry"/></mxCell><mxCell id="mission-org-goals" value="&lt;b&gt;业务目标锚定与小核心组&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;先立可量化目标（如 6 个月百名创作者、年省 500 工时），设 2–3 名负责人与高管赞助人&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="three-phase-skilling" value="&lt;b&gt;三阶分层培育（Onboarding → Advanced）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;安全首建智能体 → 连接业务数据与黑客松 → 复杂场景实战并反哺知识库与导师带教&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="goal-matched-events" value="&lt;b&gt;按目标匹配四类点燃活动（The Spark）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Meetup 唤起认知、Workshop 实操练兵、Hackathon 攻坚真问题、年度 Showcase 表彰&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="champion-office-hours" value="&lt;b&gt;先锋答疑（Office Hours）与同侪互助&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;将有话语权的质疑者转化为先锋导师，支撑数小时内同侪响应（如 ZF 20 人服务 3.7 万人）&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="native-work-tools" value="&lt;b&gt;复用员工原生协作阵地&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;不强迁外部群组：Viva Engage 开放论坛、SharePoint 知识库、Teams 直播、Forms 脉搏调研&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="product-grade-metrics" value="&lt;b&gt;产品化四维度量与治理护栏&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;拒绝虚荣群人数，按触达、留存参与、技能进阶与投产节省工时汇报，配托管环境与 A365&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="four-partner-coalition" value="&lt;b&gt;四类跨部门伙伴联盟&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;IT 安全与数据分析把关治理、业务部门锚定场景、M365 先锋促活、高管与 MVP 联合背书&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="four-step-recognition" value="&lt;b&gt;四阶荣誉晋升阶梯&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;通过聚光灯故事与徽章，推动新成员 → 活跃创作者 → 带教先锋 → 跨分会社区领袖&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="enterprise-scale-roi" value="&lt;b&gt;全企规模化业务回报复利&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;实现 PG&amp;amp;E 年省 7500 万美元、Heineken 5 人支撑 7800+ 创作者、Hiscox 采纳率跃升至 74%&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="e1" value="按业务目标定制技能" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mission-org-goals" target="three-phase-skilling"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="每期学员产出新讲师" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="three-phase-skilling" target="goal-matched-events"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="火花导入长效引擎" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="goal-matched-events" target="champion-office-hours"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="日常答疑与论坛沉淀" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="champion-office-hours" target="native-work-tools"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="采集留存与投产遥测" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="native-work-tools" target="product-grade-metrics"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="量化战报赢得伙伴支持" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="product-grade-metrics" target="four-partner-coalition"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="联合表彰与资源倾斜" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="four-partner-coalition" target="four-step-recognition"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="激活下一波创作者" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html