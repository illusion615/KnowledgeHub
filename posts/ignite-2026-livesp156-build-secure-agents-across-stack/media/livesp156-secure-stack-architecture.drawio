<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="系统架构图"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-builder-layer" value="1. 双轨构建入口与环境分级区（Copilot Studio 业务构建 · Microsoft Foundry 专业代码）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="44" y="40" width="992" height="186" as="geometry"/></mxCell><mxCell id="group-identity-layer" value="2. 数字安全门禁卡底座（Microsoft Entra 智能体身份 · 最小权限 · 离职继承闭环）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="44" y="260" width="992" height="186" as="geometry"/></mxCell><mxCell id="group-control-plane-layer" value="3. 全域统一控制面与防线（Microsoft Agent 365 资产遥测 · Purview 数据 · Defender 威胁）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="44" y="480" width="992" height="186" as="geometry"/></mxCell><mxCell id="biz-studio" value="&lt;b&gt;业务人员构建区 (Copilot Studio)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;低代码快速原型 · 分区连接器策略防越界&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="158" y="112" width="292" height="90" as="geometry"/></mxCell><mxCell id="pro-foundry" value="&lt;b&gt;专业代码研发区 (Microsoft Foundry)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;复杂多步推理与工具编排 · 源码仓库协同交付&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="630" y="112" width="292" height="90" as="geometry"/></mxCell><mxCell id="entra-badge" value="&lt;b&gt;Entra 专属身份门禁卡&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;独立于人类凭据 · 条件访问与 API 角色收敛&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="79" y="332" width="292" height="90" as="geometry"/></mxCell><mxCell id="access-pkg" value="&lt;b&gt;时限访问包 (Access Packages)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;拒绝永久授权遗忘 · 如 30 天期满由主管续签&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="394" y="332" width="292" height="90" as="geometry"/></mxCell><mxCell id="lifecycle-wf" value="&lt;b&gt;生命周期继承流 (Lifecycle Workflows)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;所有者离职自动由直属经理接管 · 杜绝孤儿智能体&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="709" y="332" width="292" height="90" as="geometry"/></mxCell><mxCell id="agent-365" value="&lt;b&gt;Agent 365 中央资产与遥测台&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;汇聚双轨全量清单 · 透视动作、数据与工具调用&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="79" y="552" width="292" height="90" as="geometry"/></mxCell><mxCell id="purview-data" value="&lt;b&gt;Microsoft Purview 数据护栏&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;复用员工级敏感度标签 · 数据防泄漏与合规审计&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;stroke