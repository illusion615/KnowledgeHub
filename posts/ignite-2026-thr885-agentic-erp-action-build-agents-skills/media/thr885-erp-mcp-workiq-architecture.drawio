<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="Dynamics 365 ERP MCP 与 Work IQ 智能体底座架构（THR885）"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-client-harnesses-plane" value="1. 智能体客户端与运行宿主层（Client Harnesses: Copilot Studio · Cowork · Pro-Code）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1440" height="190" as="geometry"/></mxCell><mxCell id="group-work-iq-mcp-plane" value="2. Work IQ 与远程 MCP 路由层（Read-Only Ask · 650K Operations · Custom Configs）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="238" width="1440" height="190" as="geometry"/></mxCell><mxCell id="group-fno-context-security-plane" value="3. Dynamics 365 F&amp;O 业务上下文与内核安全层（10.0.51 Dual-ID Security · Skills · AOT）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="452" width="1440" height="190" as="geometry"/></mxCell><mxCell id="copilot-studio-makers" value="&lt;b&gt;Copilot Studio 自定义业务智能体&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;挂载 Work IQ 或直连 ERP MCP 工具，编排跨财务与供应链的自动化业务流&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="cowork-m365-surface" value="&lt;b&gt;Copilot Cowork 与 M365 Copilot Chat&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Cowork 同时支持问答与行动执行；Copilot Chat 当前仅开放只读问答检索&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="vscode-claude-clients" value="&lt;b&gt;VS Code GitHub Copilot 与第三方客户端&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Claude 等外部宿主通过远程连接接入 Work IQ MCP 服务共享同一套业务上下文&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="workiq-ask-search" value="&lt;b&gt;Work IQ Ask：42 个高频实体只读检索&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;基于 Dataverse 搜索与 ACS 索引提供毫秒级自然语言全文问答与快速数据核验&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="erp-mcp-do-action" value="&lt;b&gt;Work IQ Do Action + ERP MCP（65 万项操作）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;超越增删改查：基于视图模型驱动表单交互、点击按钮执行逻辑并返回记录深链&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="mcp-custom-configs" value="&lt;b&gt;MCP 多套可调配置与附件资源下载&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;告别硬编码上限：按场景自定义阈值配置，减少工具调用轮次并拉取附件入上下文&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="dual-id-security-kernel" value="&lt;b&gt;10.0.51 双身份内核安全裁剪（User + Agent ID）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;同时校验用户与智能体标识，支持派生删减版角色（如 AR Clerk - Agent）降权运行&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="business-skills-aot" value="&lt;b&gt;Business Skills（AOT 内置节点与自定义技能）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;遵循 Agent Skills 规范保存在 F&amp;amp;O 内，按安全角色跨所有客户端宿主一致共享&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="ai-metadata-descriptions" value="&lt;b&gt;AI Descriptions 元数据增强与 X++ 业务逻辑&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;在表单、实体和字段标签提示之外补充对象语义说明，消除晦涩数据模型歧义&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="e1" value="挂载工具" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="copilot-studio-makers" target="erp-mcp-do-action"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="自然语言问答" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cowork-m365-surface" target="workiq-ask-search"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="Cowork 执行动作" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cowork-m365-surface" target="erp-mcp-do-action"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="远程 MCP 连接" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="vscode-claude-clients" target="mcp-custom-configs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="注入场景参数" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mcp-custom-configs" target="erp-mcp-do-action"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="受控读取" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="workiq-ask-search" target="dual-id-security-kernel"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="携带双 ID 鉴权" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="erp-mcp-do-action" target="dual-id-security-kernel"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="发现与沉淀技能" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="erp-mcp-do-action" target="business-skills-aot"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="协同语义引导" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="business-skills-aot" target="ai-metadata-descriptions"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
