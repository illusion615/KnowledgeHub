<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="系统架构图"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-authoring-layer" value="1. 任意创作入口与源码协同层（Build Where You Want · Git-Backed）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="44" y="40" width="992" height="184" as="geometry"/></mxCell><mxCell id="group-runtime-layer" value="2. Microsoft Copilot 托管运行时（Unified Hosting · Identity · Connectors）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="44" y="258" width="992" height="184" as="geometry"/></mxCell><mxCell id="group-governance-layer" value="3. Microsoft 365 管理中心与持久化底座（Enterprise Control Plane &amp; Data）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="44" y="476" width="992" height="184" as="geometry"/></mxCell><mxCell id="flow-work" value="&lt;b&gt;业务流对话构建（Cowork / Studio）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;自然语言生成微应用、智能体与审批工作流&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="79" y="112" width="292" height="88" as="geometry"/></mxCell><mxCell id="code-first" value="&lt;b&gt;代码优先工具（Copilot Code / CLI）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;VS Code · GitHub 仓库分支评审 · 本地调试&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=