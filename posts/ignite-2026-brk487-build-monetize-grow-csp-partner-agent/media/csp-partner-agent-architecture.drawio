<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="CSP 合作伙伴智能体全栈平台与双轨构建路径架构（BRK487）"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-iq-foundation" value="1. 组织上下文与统一数据底座（Microsoft IQ &amp; Unified Data Layer）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1440" height="188" as="geometry"/></mxCell><mxCell id="group-dual-paths" value="2. 五问选型与双轨构建运行引擎（Path A 托管速赢 vs. Path B 代码深耕）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="236" width="1440" height="188" as="geometry"/></mxCell><mxCell id="group-scale-monetize" value="3. 内建分发渠道、规模治理与经常性变现（Distribution, Agent 365 &amp; CSP FinOps）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="448" width="1440" height="188" as="geometry"/></mxCell><mxCell id="work-web-iq" value="&lt;b&gt;Work IQ · Web IQ · 业务插件&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;沉淀生产力工作流、文档邮件脉络与实时外部商业信息&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="94" width="320" height="94" as="geometry"/></mxCell><mxCell id="fabric-foundry-iq" value="&lt;b&gt;Fabric IQ · Foundry IQ（数据就绪）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Microsoft Fabric 统一业务数据 + 非结构化文档与多模型知识索引&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="94" width="320" height="94" as="geometry"/></mxCell><mxCell id="third-party-iq" value="&lt;b&gt;3rd-Party IQ 与专属 Customer IQ&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;打通 Workday / ADP / ERP 异构系统，封装可复用行业插件 IP&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="94" width="320" height="94" as="geometry"/></mxCell><mxCell id="path-a-studio" value="&lt;b&gt;Path A：Copilot Studio 托管速赢&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;低代码数天至数周上线；适配标准流程与现成连接器（$2.4K → $10K–$18K）&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="306" width="320" height="94" as="geometry"/></mxCell><mxCell id="five-q-router" value="&lt;b&gt;五维选型评估框架（5-Question Fit）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;按流程复杂度、遗留系统写回、私网合规、无证一线终端与研发人力分流&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="306" width="320" height="94" as="geometry"/></mxCell><mxCell id="path-b-foundry" value="&lt;b&gt;Path B：GitHub + Microsoft Foundry&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;多模型评测追踪、自定义 API 写回与 CI/CD 资产沉淀（$15K → $44K–$84K）&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="306" width="320" height="94" as="geometry"/></mxCell><mxCell id="builtin-reach" value="&lt;b&gt;零获客内建触达（450M+ M365 席位）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;直达 3.2 亿 Teams 月活、2,000 万 Copilot 席位及无证车间终端/网页&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="518" width="320" height="94" as="geometry"/></mxCell><mxCell id="agent-365-gov" value="&lt;b&gt;Agent 365 与 Azure 主权安全治理&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;跨国数据驻留控制、Entra ID 身份权限、持续质量调优与 AI FinOps 控费&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="518" width="320" height="94" as="geometry"/></mxCell><mxCell id="csp-recurring" value="&lt;b&gt;CSP 账单绑定与多智能体托管复利&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;六层收益叠加 + Marketplace 上架；管至第 4 个智能体达 $14.5K 年经常性收入&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="518" width="320" height="94" as="geometry"/></mxCell><mxCell id="edge-1" value="原生挂载上下文" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="work-web-iq" target="path-a-studio"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-2" value="评估数据就绪度" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="fabric-foundry-iq" target="five-q-router"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-3" value="异构系统写回" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="third-party-iq" target="path-b-foundry"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-4" value="Teams 开箱即用" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="path-a-studio" target="builtin-reach"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-5" value="安全与边界策略" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="five-q-router" target="agent-365-gov"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-6" value="沉淀可复用 IP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="path-b-foundry" target="csp-recurring"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
