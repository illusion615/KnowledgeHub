<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="系统架构图"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-intent-process-layer" value="1. 流程智能诊断与混合运营模型设计（IBM Consulting 6,000+ 预置智能体 · 人机协同 RACI）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="44" y="40" width="992" height="188" as="geometry"/></mxCell><mxCell id="group-manifest-build-layer" value="2. 清单契约交接与微软双轨构建层（Manifest 编排包 · Microsoft Foundry · Copilot Studio &amp; Fabric）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="44" y="262" width="992" height="188" as="geometry"/></mxCell><mxCell id="group-govern-roi-layer" value="3. 数字劳动力 SLO 治理与价值度量大盘（Entra + Agent 365 + APIM · 代码血缘与 PIP · 业务 ROI）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="44" y="484" width="992" height="188" as="geometry"/></mxCell><mxCell id="process-ingest" value="&lt;b&gt;流程采集与瓶颈诊断&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;导入 SOP 与原型 · 识别 47 条路径与 31% 等待摩擦&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="79" y="112" width="292" height="92" as="geometry"/></mxCell><mxCell id="process-reimagine" value="&lt;b&gt;流程重构 (28 步压缩至 11 步)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;人机对话修订 · 砍除 ERP 至承运商门户重复录入&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="394" y="112" width="292" height="92" as="geometry"/></mxCell><mxCell id="operating-raci" value="&lt;b&gt;人机席位与 RACI 决策权&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;划分纯数字/混合/人类席位 · &amp;gt;$5,000 贷项双人复核&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="709" y="112" width="292" height="92" as="geometry"/></mxCell><mxCell id="manifest-bundle" value="&lt;b&gt;版本化清单包 (Manifest Handoff)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;封装 Markdown、智能体定义、业务本体与固定护栏&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="79" y="334" width="292" height="92" as="geometry"/></mxCell><mxCell id="foundry-copilot" value="&lt;b&gt;Foundry 与 Copilot Studio 组装&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;组合 IBM 6,000+ 资产 · 编排 24 名数字员工 (46 智能体)&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="394" y="334" width="292" height="92" as="geometry"/></mxCell><mxCell id="azure-fabric-apim" value="&lt;b&gt;Fabric 数据底座与 APIM 网关&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;挂载 erp-ar/policy-kb 工具 · 执行 ai-gateway 策略&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="709" y="334" width="292" height="92" as="geometry"/></mxCell><mxCell id="entra-a365-identity" value="&lt;b&gt;Entra 与 Agent 365 身份管控&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&