<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="Context&amp; 推理型投资组合管理（PPM）三层工程架构（THR977）"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-dataverse-foundation-plane" value="1. 数据底座与角色安全继承层（Dataverse Region Control &amp; Inherited RBAC）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1440" height="190" as="geometry"/></mxCell><mxCell id="group-interactive-simulation-plane" value="2. 模型驱动宿主与毫秒级假设推演层（Model-Driven Power App + Vibe-Coded HTML Web Resource）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="238" width="1440" height="190" as="geometry"/></mxCell><mxCell id="group-dual-ai-and-board-output-plane" value="3. 本云双模推理评审与董事会汇报交付层（Per-User Local/Cloud AI &amp; Instant PowerPoint）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="452" width="1440" height="190" as="geometry"/></mxCell><mxCell id="dataverse-baseline" value="&lt;b&gt;Dataverse 实时基线库（支持 1,000+ 项目）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;统一承载预算成本中心、甘特里程碑、角色工时需求与净现值等动态数值列&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="xpm-model-driven-host" value="&lt;b&gt;Projectum xPM 模型驱动应用宿主&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;服务全球 100+ 企业客户的成熟底座，提供千人千面实时欢迎页与基线采集&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="dataverse-rbac-security" value="&lt;b&gt;数据随行安全模型与区域合规控制&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;推演方案自动继承 Dataverse 行级权限，无权访问的项目绝不进入模拟视野&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="vibe-html-simulator" value="&lt;b&gt;HTML Web Resource 实时假设模拟器&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;复刻筛选排序与资源热力图，内存级无损测算预算上限（如 $70M/$120M）与排期平移&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="guided-prioritization" value="&lt;b&gt;8 步引导式优先级向导与前沿甜点曲线&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;串联必选锁定、100% 权重归一化与成对比较，定位 $37M 投入捕获过半价值的甜点&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="instant-pptx-engine" value="&lt;b&gt;亚秒级董事会简报直出引擎（免流编排）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;无需 Power Automate 或实时大模型推理，0.5 秒内将精确指标写入 7 页高管模板&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="local-lm-studio" value="&lt;b&gt;终端本地推理（LM Studio · 数据不出本机）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;在本机运行 qwen3-vl-8b 实时渲染健康度看板，识别 DevOps 400% 过载并回写结论&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="markdown-cloud-copilot" value="&lt;b&gt;一键导出结构化 Markdown 对接任意云端 AI&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;免建专用智能体与复杂检索，复制含提示词与多方案明细的文本即可跨模型问答&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="saved-verdict-loop" value="&lt;b&gt;决策结论、瓶颈预警与行动项持久化&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;将 AI 评审裁决、风险隐患与调配建议随方案一并存回 Dataverse 供管委会横向比对&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="e1" value="读取实时基线" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dataverse-baseline" target="vibe-html-simulator"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="内嵌承载" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="xpm-model-driven-host" target="vibe-html-simulator"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="继承行级权限" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dataverse-rbac-security" target="guided-prioritization"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="实时约束重排" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="vibe-html-simulator" target="guided-prioritization"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="直填高管模板" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="guided-prioritization" target="instant-pptx-engine"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="断网本机评审" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="guided-prioritization" target="local-lm-studio"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="复制完整简报" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="guided-prioritization" target="markdown-cloud-copilot"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="生成看板与裁决" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="local-lm-studio" target="saved-verdict-loop"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="随方案回写归档" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="saved-verdict-loop" target="dataverse-baseline"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
