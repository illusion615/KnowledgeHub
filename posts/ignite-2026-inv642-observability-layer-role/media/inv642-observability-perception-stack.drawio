<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="企业级全栈可观测性与自主安全防御统一架构（INV642：Agent 365 + Microsoft Perception）"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-role-decision-plane" value="1. 四大核心角色协同控制面（IT 管理 · 业务负责人 · SecOps 与研发 · 终端用户）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1440" height="194" as="geometry"/></mxCell><mxCell id="group-perception-harness-plane" value="2. Microsoft Perception 多模型红/蓝/绿智能体编排框架（Playbooks + 专用模型路由）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="242" width="1440" height="194" as="geometry"/></mxCell><mxCell id="group-context-registry-plane" value="3. 160 万亿日信号安全图谱、单一智能体注册表与沙箱围栏底座（Shared Context + MXC）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="1440" height="194" as="geometry"/></mxCell><mxCell id="a365-action-center" value="&lt;b&gt;Agent 365 Action Center（IT 治理）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;跨多 Entra 租户纳管异构平台与 MCP 工具；自动将无主智能体转交前任主管并联动预估封顶&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="94" width="320" height="100" as="geometry"/></mxCell><mxCell id="biz-analytics-finops" value="&lt;b&gt;Business Analytics 业务预算委派&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;承接 80% 业务部门自筹预算；模拟模型降级基线、核算用例价值并通过 Azure 订阅回扣&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="94" width="320" height="100" as="geometry"/></mxCell><mxCell id="access-orchestrator-ux" value="&lt;b&gt;Access Orchestrator 与多形态入口&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;终端用户一次授权按任务动态最小赋权；安全人员可从内嵌门户、独立看板或 CLI 审批&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="94" width="320" height="100" as="geometry"/></mxCell><mxCell id="blue-defend-agents" value="&lt;b&gt;蓝队智能体链（分诊 · 调查 · 写规则）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;消化传统 SOC 漏看超 50% 的告警洪流，以四线专家深度还原攻击图谱并自动编写检测代码&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="312" width="320" height="100" as="geometry"/></mxCell><mxCell id="red-pentest-agents" value="&lt;b&gt;红队智能体（攻击面测绘与动态渗透）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;承接 MDASH 代码扫描结果并调用 SQLMap/Nmap 实测验证，将 48 项告警收敛为 3 个真漏洞&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="312" width="320" height="100" as="geometry"/></mxCell><mxCell id="green-posture-agents" value="&lt;b&gt;绿队智能体 + MAI-Cyber 2 成本引擎&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;直连 GitHub 提交修复 PR、联动 ServiceNow 封堵暴露面；专用模型以 2% 成本达成旗舰精度&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="312" width="320" height="100" as="geometry"/></mxCell><mxCell id="unified-agent-registry" value="&lt;b&gt;单一智能体记录系统（ERP for AI）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;IT 与安全共享同一资产清册，统揽微软原生及 Bedrock、Databricks、Claude Code、OpenCLAW&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="530" width="320" height="100" as="geometry"/></mxCell><mxCell id="security-exposure-graph" value="&lt;b&gt;160 万亿信号安全与暴露图谱&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;融合 Defender、Entra、Purview、Intune、Sentinel 与三方遥测，毫秒级映射资产攻击路径&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="530" width="320" height="100" as="geometry"/></mxCell><mxCell id="mxc-containment-id" value="&lt;b&gt;MXC 沙箱隔离与人机身份解耦&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;为三方与本地智能体套上执行容器、分配独立身份并计算动态风险；阻断恶化智能体且不误封本人&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="530" width="320" height="100" as="geometry"/></mxCell><mxCell id="e1" value="全网发现与双端同步" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="security-exposure-graph" target="unified-agent-registry"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="聚合健康度与无主告警" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="unified-agent-registry" target="a365-action-center"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="委派部门预算与回扣" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="a365-action-center" target="biz-analytics-finops"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="注入实时关系上下文" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="security-exposure-graph" target="blue-defend-agents"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="联动威胁模拟与复测" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="blue-defend-agents" target="red-pentest-agents"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="交付已证实利用链" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="red-pentest-agents" target="green-posture-agents"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="动态风险阻断但保留员工访问" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mxc-containment-id" target="access-orchestrator-ux"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
