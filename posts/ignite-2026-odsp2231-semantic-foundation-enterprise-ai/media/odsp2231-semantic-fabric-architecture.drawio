<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="Semantic Fabric 企业智能体共享语义与知识图谱三层架构（ODSP2231）"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-ontology-engineering-plane" value="1. 本体市场与人机协同建模层（Ontology Marketplace · Doc-to-Ontology · SME Review）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1440" height="190" as="geometry"/></mxCell><mxCell id="group-kg-pipeline-onelake-plane" value="2. OWL 知识图谱管线与 OneLake 治理层（10-Step KG Pipeline · Fuseki · Purview）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="238" width="1440" height="190" as="geometry"/></mxCell><mxCell id="group-agent-consumption-plane" value="3. 共享企业上下文与智能体消费层（NLQ → SPARQL → SQL · Copilot Studio · Foundry）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="452" width="1440" height="190" as="geometry"/></mxCell><mxCell id="ontology-marketplace" value="&lt;b&gt;本体资产市场（4 大分组 / 44 套资产）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;内置 BFO/DOLCE/SUMO 顶层本体与 FIBO/PROV-O/SKOS 跨域及行业包&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="doc-to-ontology-gen" value="&lt;b&gt;Doc-to-Ontology 七步文档抽取管线&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;经 Tika 解析、语义分块、领域分类与去重合并，从业务文档生成 251 个类&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="sme-governance-gate" value="&lt;b&gt;领域专家三视图审阅门禁（Approve / Reject）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;通过层级、树状与辐射视图核验类及属性关系，结合 Gitea 版本与 Purview 管控&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="owl-jena-rdfs-engine" value="&lt;b&gt;OWL 解析、Jena 校验与 RDFS 闭包推理&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;解析校验 39 个核心类与 1,312 条三元组，经 RDFS 推理增补至 1,319 条&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="fuseki-shacl-store" value="&lt;b&gt;Fuseki 命名图谱与 SHACL 零违例校验&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;落盘至命名图谱端点并通过 SHACL 形状约束（0 违例），完成向量嵌入索引&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="onelake-fabric-alignment" value="&lt;b&gt;OneLake 底座对齐（Fabric IQ · Power BI）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;打通业务数据库、应用与指标注册表，消除跨报表与跨智能体的口径漂移&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="nlq-sparql-sql-bridge" value="&lt;b&gt;NLQ → SPARQL → SQL 双跳确定性转译&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;先检索图谱中 7 项商户语义映射，再精确生成针对生产 PostgreSQL 的 SQL&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="copilot-studio-agents" value="&lt;b&gt;Copilot Studio 与 Fabric 数据智能体&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;让业务人员用日常语言直接提问，无需记忆底层物理表名或复杂连接键&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="foundry-iq-ecosystem" value="&lt;b&gt;Microsoft Foundry 与 Foundry IQ 复用&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;跨定制智能体、分析工作台与后续 AI 项目复用同一受控知识资产与溯源链&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="e1" value="克隆基线本体" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ontology-marketplace" target="doc-to-ontology-gen"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="提交候选类与属性" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="doc-to-ontology-gen" target="sme-governance-gate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="专家批准入库" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sme-governance-gate" target="owl-jena-rdfs-engine"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="1,319 条三元组" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="owl-jena-rdfs-engine" target="fuseki-shacl-store"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="绑定物理库表映射" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="fuseki-shacl-store" target="onelake-fabric-alignment"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="SPARQL 语义消歧" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="fuseki-shacl-store" target="nlq-sparql-sql-bridge"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="注入共享业务口径" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="onelake-fabric-alignment" target="copilot-studio-agents"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="有据可查结果" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="nlq-sparql-sql-bridge" target="copilot-studio-agents"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="跨平台语义复用" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="onelake-fabric-alignment" target="foundry-iq-ecosystem"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
