<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="Copilot Studio 结合 Snowflake MCP Server 与 Cortex Agents 的三层受控数据架构（ODSP2233）"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-microsoft-workplace-plane" value="1. 微软协同工作流与编排层（Microsoft 365 Teams · Copilot Studio · Microsoft Foundry）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1440" height="190" as="geometry"/></mxCell><mxCell id="group-mcp-security-bridge-plane" value="2. 协议与身份治理桥接层（Snowflake MCP Server · Entra External OAuth · Cortex Agents）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="238" width="1440" height="190" as="geometry"/></mxCell><mxCell id="group-snowflake-data-cloud-plane" value="3. Snowflake AI Data Cloud 双模推理与数据层（Cortex Analyst 语义视图 · Cortex Search 非结构化）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="452" width="1440" height="190" as="geometry"/></mxCell><mxCell id="m365-teams-copilot" value="&lt;b&gt;M365 Teams 与业务前端渠道&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;非技术业务人员在日常聊天流中用自然语言直询库存、运营与客户动态&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="copilot-studio-hub" value="&lt;b&gt;Microsoft Copilot Studio 编排中枢&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;融合低代码拖拽与 YAML 代码模型（Skills for Copilot Studio），统筹跨源工作流&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="foundry-azure-openai" value="&lt;b&gt;Microsoft Foundry 与 Azure OpenAI&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;为复杂智能体提供前沿模型底座，并支持在 Snowflake Cortex 内直接调用&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="entra-oauth-rbac" value="&lt;b&gt;Entra External OAuth / SSO 与角色授权&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;执行 OAuth 令牌透传与 GRANT USAGE ON MCP SERVER 最小角色隔离&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="snowflake-mcp-server" value="&lt;b&gt;托管式 Snowflake MCP Server&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;通过 CREATE MCP SERVER 将 CORTEX_AGENT_RUN 标准化暴露为协议工具&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="cortex-agent-broker" value="&lt;b&gt;Snowflake Cortex Agent 智能路由&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;由 Cortex Code 辅助构建，自主裁决调用结构化指标分析或非结构化对话检索&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="cortex-analyst-sql" value="&lt;b&gt;Cortex Analyst（结构化 Text-to-SQL）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;基于 sales_metrics_model.yaml 语义视图生成精准 SQL，零手工写表关联&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="cortex-search-rag" value="&lt;b&gt;Cortex Search（非结构化通话检索）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;检索 SALES_CONVERSATION_SEARCH 通话纪要，提炼关键要点与待办行动项&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="horizon-catalog-iot" value="&lt;b&gt;Horizon Catalog 治理与冷链 IoT 数仓&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;汇聚多仓 WMS、RFID 与 IoT 实时数据，全链路不绕过 Snowflake 原生安全边界&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="e1" value="自然语言提问" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m365-teams-copilot" target="copilot-studio-hub"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="OAuth 身份鉴权" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="copilot-studio-hub" target="entra-oauth-rbac"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="受控角色放行" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="entra-oauth-rbac" target="snowflake-mcp-server"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="调用 MCP 工具" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="copilot-studio-hub" target="snowflake-mcp-server"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="CORTEX_AGENT_RUN" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="snowflake-mcp-server" target="cortex-agent-broker"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="前沿模型双向赋能" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="foundry-azure-openai" target="cortex-agent-broker"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="语义视图转 SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cortex-agent-broker" target="cortex-analyst-sql"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="检索非结构化纪要" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cortex-agent-broker" target="cortex-search-rag"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="行级安全与单一事实源" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="horizon-catalog-iot" target="cortex-analyst-sql"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
