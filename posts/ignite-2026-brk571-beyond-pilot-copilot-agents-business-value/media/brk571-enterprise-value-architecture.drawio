<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="BRK571 从试点走向规模商业价值的三层跃迁与表面收敛架构"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-surface-layer" value="1. 多模态协同交互层与智能路由（正在收敛认知负荷）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="44" y="40" width="992" height="184" as="geometry"/></mxCell><mxCell id="group-rewiring-layer" value="2. 端到端业务流程重连与编排层（Rewiring · Recode · 150+ 行业插件）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="44" y="258" width="992" height="184" as="geometry"/></mxCell><mxCell id="group-governance-layer" value="3. 权限卫生、有边界创新护栏与分摊账本底座（Entra · Purview · Agent 365）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="44" y="476" width="992" height="184" as="geometry"/></mxCell><mxCell id="chat-router" value="&lt;b&gt;Copilot Chat + 智能路由器&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;许可证内轻量摘要与 Cowork 提示词预调优&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="75" y="112" width="300" height="88" as="geometry"/></mxCell><mxCell id="cowork-canvas" value="&lt;b&gt;Copilot Cowork 并排画布&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;深度策略推演、魔鬼代言人质询与会后行动方案&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="390" y="112" width="300" height="88" as="geometry"/></mxCell><mxCell id="autopilot-rail" value="&lt;b&gt;左侧栏 Autopilot 后台委派&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;移动途中一句指令代发权限、自动汇总高管简报&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="705" y="112" width="300" height="88" as="geometry"/></mxCell><mxCell id="process-recode" value="&lt;b&gt;流程拆解重连（18 步压至 4 步）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;录制真实作业流直喂 Copilot Studio 重构主干&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="75" y="330" width="300" height="88" as="geometry"/></mxCell><mxCell id="hybrid-rails" value="&lt;b&gt;前端推理 + 后端确定性轨道&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;受监管行业固化合规步骤，跨 150 款行业插件调取&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="390" y="330" width="300" height="88" as="geometry"/></mxCell><mxCell id="hub-spoke" value="&lt;b&gt;清点收敛与中枢辐射共建&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;盘点 2.5 万民间智能体提炼共性，一年期业务先锋&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="705" y="330" width="300" height="88" as="geometry"/></mxCell><mxCell id="data-hygiene" value="&lt;b&gt;数据分类重验与可观测性&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;排查 30 年历史过度共享，对话内明示访问边界&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="75" y="548" width="300" height="88" as="geometry"/></mxCell><mxCell id="bordered-sandbox" value="&lt;b&gt;有边界沙盒（Box with Borders）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;硬性合规边界内开放 1.5 万～5 万业务专家自治&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="390" y="548" width="300" height="88" as="geometry"/></mxCell><mxCell id="finops-ledger" value="&lt;b&gt;收益侧成本归属与跨栈账本&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;个人/团队/财务三级足迹看板 + 月度 $50 硬封顶&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="705" y="548" width="300" height="88" as="geometry"/></mxCell><mxCell id="edge-1" value="复杂任务升级" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chat-router" target="cowork-canvas"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-2" value="后台异步触发" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="autopilot-rail" target="process-recode"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-3" value="沉淀高频用例" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cowork-canvas" target="hybrid-rails"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-4" value="遵循 Work IQ 权限" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="process-recode" target="data-hygiene"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-5" value="DLP 与审批护栏" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hybrid-rails" target="bordered-sandbox"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-6" value="归集消耗与产出" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hub-spoke" target="finops-ledger"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
