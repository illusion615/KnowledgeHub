<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="Copilot Managed Runtime：五路构建入口汇聚单一 Git 托管与租户治理平面（BRK378）"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-authoring-surfaces" value="1. 多角色自由构建入口层（Build Where You Want · 感知前置策略）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="36" y="24" width="1308" height="180" as="geometry"/></mxCell><mxCell id="group-cmr-core-plane" value="2. Copilot Managed Runtime 统一托管内核（Git 源码仓 · 数据连接 · 智能体）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="36" y="230" width="1308" height="180" as="geometry"/></mxCell><mxCell id="group-m365-admin-plane" value="3. Microsoft 365 管理中心默认治理层（盘点隔离 · 动作白名单 · 额度上限）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="36" y="436" width="1308" height="180" as="geometry"/></mxCell><mxCell id="flow-of-work" value="&lt;b&gt;工作流内构建：Cowork 与 Copilot Studio&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;11 月 GA · 借 Work IQ 脉络与 Figma/Dataverse 插件生成智能应用&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="89" y="90" width="360" height="92" as="geometry"/></mxCell><mxCell id="pro-code-cli" value="&lt;b&gt;专业研发：Copilot Code / CLI / VS Code&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;免密钥 GCM 克隆远程 React/TS 仓，本地 dev 调测后回推生产&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="510" y="90" width="360" height="92" as="geometry"/></mxCell><mxCell id="external-sdk-lovable" value="&lt;b&gt;三方平台接入：Lovable 与 Managed SDK&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;管理员 20 分钟完成绑定；仅发布 React 前端且三方零触碰业务数据&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="931" y="90" width="360" height="92" as="geometry"/></mxCell><mxCell id="git-source-host" value="&lt;b&gt;受管托管与统一 Git 远程源码库&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;告别 localhost 孤岛；自动分配 Entra 认证域名并维护全量版本历史&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="89" y="296" width="360" height="92" as="geometry"/></mxCell><mxCell id="agentic-intelligence" value="&lt;b&gt;双模智能驱动：行内提示词 + Studio 智能体&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;轻量风险摘要调行内 LLM，复杂逾期排查挂载完整智能体（默认通 A365）&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="510" y="296" width="360" height="92" as="geometry"/></mxCell><mxCell id="data-fabric-connectors" value="&lt;b&gt;1,500+ 受管连接器与 Fabric (Rayfin) 底座&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;按需挂载 Dataverse、SharePoint、Excel 或开箱创建 Fabric 持久库&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="931" y="296" width="360" height="92" as="geometry"/></mxCell><mxCell id="env-action-csp" value="&lt;b&gt;个人沙盒、动作级白名单与严格 CSP&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;环境组路由隔离；细化至连接器单动作开关并拦截未授权外部 API&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="89" y="502" width="360" height="92" as="geometry"/></mxCell><mxCell id="mac-apps-inventory" value="&lt;b&gt;M365 管理中心 Apps 全景台账与隔离&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;集中透视全域托管应用（演示盘点 492 款），高危应用一键 Block 隔离&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="510" y="502" width="360" height="92" as="geometry"/></mxCell><mxCell id="finops-billing-policy" value="&lt;b&gt;共享策略与计费限额护栏（Billing Policy）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;管控组织链接/安全组/访客范围，按业务线设点数上限（如 5,000 限额）&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="931" y="502" width="360" height="92" as="geometry"/></mxCell><mxCell id="edge-1" value="同源写入 Git" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="flow-of-work" target="git-source-host"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-2" value="挂载智能体" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="flow-of-work" target="agentic-intelligence"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-3" value="克隆与回推" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pro-code-cli" target="git-source-host"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-4" value="纯前端直发" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="external-sdk-lovable" target="git-source-host"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-5" value="租户内直连" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="external-sdk-lovable" target="data-fabric-connectors"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-6" value="自动纳管登记" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="git-source-host" target="mac-apps-inventory"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-7" value="计入消费账本" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="agentic-intelligence" target="finops-billing-policy"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-8" value="执行动作校验" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="data-fabric-connectors" target="env-action-csp"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
