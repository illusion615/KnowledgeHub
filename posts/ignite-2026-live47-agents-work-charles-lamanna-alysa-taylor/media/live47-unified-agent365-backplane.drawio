<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="Copilot、Work IQ 与 Agent 365 无断崖统一智能体控制背板（LIVE47）"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-proactive-surfaces" value="1. 主动式协同与多元智能体入口层（Proactive Work Surfaces &amp; Heterogeneous Fleet）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1440" height="190" as="geometry"/></mxCell><mxCell id="group-unified-backplane" value="2. 无断崖共享背板层（Work IQ 图谱 · 共享插件注册表 · Entra 智能体身份）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="238" width="1440" height="190" as="geometry"/></mxCell><mxCell id="group-agent365-governance" value="3. Agent 365 全域治理与可观测底座（“智能体时代的 Intune” · 跨云开箱即连）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="452" width="1440" height="190" as="geometry"/></mxCell><mxCell id="copilot-proactive" value="&lt;b&gt;Copilot Today · Workspace · Autopilot&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;免提示词推送晨间五件要事简报、人机共创项目空间与全天候巡航（如 Apollo）&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="studio-foundry-github" value="&lt;b&gt;Copilot Studio · Foundry · GitHub 智能体&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;跨低代码流程重构、专业模型编排与研发协同工具构建的第一方智能体矩阵&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="external-cloud-agents" value="&lt;b&gt;多云异构智能体（Anthropic / AWS / GCP）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;拥抱企业真实异构生态，非微软运行时智能体同享统一日志注入与花费核算&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="work-iq-graph" value="&lt;b&gt;Work IQ 工作与人脉语义图谱&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;理解协作关系、紧急汇报链与在途项目上下文，驱动主动式任务推荐与发起&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="plugin-skill-registry" value="&lt;b&gt;统一插件与技能注册表（Plugin Registry）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;一处注册即可跨 GitHub Copilot、Copilot 与 Autopilot 一致发现并受控加载&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="entra-agent-id" value="&lt;b&gt;Microsoft Entra 智能体身份与零信任隔离&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;复用已正式商用的 Entra Agent ID / User ID、网络与密钥隔离及 Windows MXC 容器&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="agent365-finops" value="&lt;b&gt;Agent 365 商业分析与花费封顶看板&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;充当跨生态 AI 支出的 ERP/BI 仪表盘，同步设定预算上限、预测并核算产出价值&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="otel-observability" value="&lt;b&gt;OpenTelemetry（OTEL）开放全链路观测&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;追踪连接目标、工具来源、决策轨迹与报错，双向打通企业既有数据湖与 SIEM&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="intune-estate-admin" value="&lt;b&gt;全域智能体资产盘点与统一管理控制&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;如同 Intune 统管 iOS/Android/PC/Mac，一套管理台纳管任意平台的智能体生命周期&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="e1" value="图谱唤醒" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="copilot-proactive" target="work-iq-graph"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="共享技能" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="copilot-proactive" target="plugin-skill-registry"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="一致调用" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="studio-foundry-github" target="plugin-skill-registry"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="继承权限" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="studio-foundry-github" target="entra-agent-id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="零信任边界" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="external-cloud-agents" target="entra-agent-id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="业务产出归因" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="work-iq-graph" target="agent365-finops"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="技能溯源" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="plugin-skill-registry" target="otel-observability"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="OTEL 日志注入" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="external-cloud-agents" target="otel-observability"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="统一策略下发" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="entra-agent-id" target="intune-estate-admin"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
