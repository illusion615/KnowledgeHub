<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="Aon 企业级 AI 转型三层控制面与三区员工赋能架构"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-workforce-zones" value="1. 三区同事赋能面：按岗位匹配工具（150 国 70,000 名同事 + 2,000 名 AI 激活师）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1420" height="188" as="geometry"/></mxCell><mxCell id="group-foundry-gateway" value="2. 统一生成式 AI 网关与可复用业务模式面（Azure AI Foundry Control Plane）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="236" width="1420" height="188" as="geometry"/></mxCell><mxCell id="group-trusted-foundation" value="3. 现代化云底座与可信主数据层（Aon Business Services · 13–14 亿美元三年投入）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="448" width="1420" height="188" as="geometry"/></mxCell><mxCell id="zone1-m365" value="&lt;b&gt;第一区：全员日常协同（M365 Copilot）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;覆盖 60,000+ 同事日常邮件与会议协同，视作现代办公基础必需品&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="134" y="94" width="318" height="94" as="geometry"/></mxCell><mxCell id="zone2-lowcode" value="&lt;b&gt;第二区：属地敏捷创新（Copilot Studio）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;承接澳洲小型商业险等区域长尾流，叠加用量护栏与模型选型约束&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="591" y="94" width="318" height="94" as="geometry"/></mxCell><mxCell id="zone3-procode" value="&lt;b&gt;第三区：专业工程构建（GitHub Copilot）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;平台工程师打造 Certificate Center、Broker Copilot 与 Claims Copilot&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1048" y="94" width="318" height="94" as="geometry"/></mxCell><mxCell id="genai-wrapper" value="&lt;b&gt;GenAI Wrapper 单一控制面网关&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;强制拦截全部大模型调用（绕过禁发生产），跨云路由 GPT / Claude / Gemini&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="134" y="306" width="318" height="94" as="geometry"/></mxCell><mxCell id="foundry-patterns" value="&lt;b&gt;标准化文档处理与比对组件&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;一次构建多文档解析、批单核对与摘要模板，跨美加与多险种复用&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="591" y="306" width="318" height="94" as="geometry"/></mxCell><mxCell id="ai-finops" value="&lt;b&gt;业务价值账本（AI FinOps 计量）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;屏蔽底层词元计费歧义，按单笔保单、理赔、证书或会话核算投入产出&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1048" y="306" width="318" height="94" as="geometry"/></mxCell><mxCell id="app-cloud-mod" value="&lt;b&gt;2,200+ 应用精简与 22 座数据中心迁云&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;存量应用削减 30%–40%，80% 核心工作负载迁入 Azure 主云底座&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="134" y="518" width="318" height="94" as="geometry"/></mxCell><mxCell id="trusted-data" value="&lt;b&gt;主数据抽象层（Trusted Data Layer）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;打通保单、理赔、风险敞口、账单与客户全生命周期可信战略资产&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="591" y="518" width="318" height="94" as="geometry"/></mxCell><mxCell id="entra-guardrails" value="&lt;b&gt;Entra 统一身份与受监管审计&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;为每位智能体与同事绑定权限边界、全链路可观测性与保险合规护栏&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1048" y="518" width="318" height="94" as="geometry"/></mxCell><mxCell id="edge-1" value="受管访问" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="zone1-m365" target="genai-wrapper"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-2" value="统一网关路由" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="zone2-lowcode" target="genai-wrapper"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-3" value="复用标准模板" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="zone3-procode" target="foundry-patterns"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-4" value="词元与成本遥测" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="genai-wrapper" target="ai-finops"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-5" value="身份与合规校验" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="genai-wrapper" target="entra-guardrails"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-6" value="挂载可信数据" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="foundry-patterns" target="trusted-data"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-7" value="清洗供数" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="app-cloud-mod" target="trusted-data"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
