<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="Copilot Studio 三大执行底座（Harnesses）选型矩阵与统一平台治理架构（BRK264）"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-workload-plane" value="1. 业务场景与体验延迟特征层（Business Process, Latency &amp; Audience Profile）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1440" height="192" as="geometry"/></mxCell><mxCell id="group-harness-plane" value="2. Copilot Studio 三大可选执行底座层（Three Specialized Agent Harnesses）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="1440" height="192" as="geometry"/></mxCell><mxCell id="group-platform-plane" value="3. 跨底座统一企业平台能力层（Same Platform, Whichever Harness）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="456" width="1440" height="192" as="geometry"/></mxCell><mxCell id="complex-process" value="&lt;b&gt;复杂跨系统与多变证据流程&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;投资组合穿透核查、20+ 格式保单抽取等长周期、重准确度任务&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="94" width="320" height="98" as="geometry"/></mxCell><mxCell id="external-omnichannel" value="&lt;b&gt;外部客户全渠道实时交互&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;电话 IVR、官网微件与 Teams Phone 超低延迟语音对话与坐席协同&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="94" width="320" height="98" as="geometry"/></mxCell><mxCell id="legacy-rule-chat" value="&lt;b&gt;存量规则型单轮问答资产&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;已上线预定义分支对话或绑定 M365 Copilot 坐席许可的延续性场景&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="94" width="320" height="98" as="geometry"/></mxCell><mxCell id="ms-copilot-harness" value="&lt;b&gt;Microsoft Copilot 底座&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;基于 Copilot SDK 自愈循环 + Azure 容器沙盒，按用量点数计费&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="310" width="320" height="98" as="geometry"/></mxCell><mxCell id="customer-conv-harness" value="&lt;b&gt;客户对话底座（现已 GA）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;原生实时语音模型 + 单画布多子代理，融合生成式技能与确定性主题&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="310" width="320" height="98" as="geometry"/></mxCell><mxCell id="standard-harness" value="&lt;b&gt;标准底座（Standard 延续支持）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;2023 分步窄提示架构，保留兼容既有投资；新建智能体建议选新底座&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="310" width="320" height="98" as="geometry"/></mxCell><mxCell id="data-models-workflows" value="&lt;b&gt;多模型选型、MCP 与确定性工作流&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Auto 跨厂商选模、Work IQ / MCP 数据接入与人工审批确定性流协同&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="526" width="320" height="98" as="geometry"/></mxCell><mxCell id="cci-integration" value="&lt;b&gt;联络中心智能（CCI · 现已 GA）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;免改路由直连 Genesys/Avaya/Five9/Cisco，内置声纹认证与后台质检代理&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="526" width="320" height="98" as="geometry"/></mxCell><mxCell id="alm-security-finops" value="&lt;b&gt;ALM、DLP 最小权限与支出治理&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Dev-Test-Prod 生命周期、Purview 审计日志、防蔓延边界与点数预测&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="526" width="320" height="98" as="geometry"/></mxCell><mxCell id="edge-1" value="长程推理首选" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="complex-process" target="ms-copilot-harness"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-2" value="实时语音/在线首选" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="external-omnichannel" target="customer-conv-harness"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-3" value="存量平滑延续" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="legacy-rule-chat" target="standard-harness"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-4" value="技能 + 审批工作流" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ms-copilot-harness" target="data-models-workflows"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-5" value="声纹核身与坐席转接" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="customer-conv-harness" target="cci-integration"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-6" value="容器外凭据与审计" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ms-copilot-harness" target="alm-security-finops"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-7" value="统一治理底座" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="standard-harness" target="alm-security-finops"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
