<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="Vanguard FAS 销售顾问智能体双路数据与人审治理架构（THR916）"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-advisor-front-door" value="1. 对话统一前门与零管道工作上下文层（Conversational Front Door &amp; Work IQ Grounding）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1440" height="190" as="geometry"/></mxCell><mxCell id="group-dual-integration-paths" value="2. 双路企业集成底座：CRM 业务技能路 vs. 多云信号路（CRM Path &amp; Enterprise-Signals Path）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="238" width="1440" height="190" as="geometry"/></mxCell><mxCell id="group-trust-governance-plane" value="3. 全链路受监管信任护栏与系统回写层（Identity, Disambiguation &amp; Human-Reviewed Write-Back）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="452" width="1440" height="190" as="geometry"/></mxCell><mxCell id="fas-sales-exec" value="&lt;b&gt;Vanguard FAS 销售代表（数百人全美展业）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;服务全美约 300,000 名外部理财顾问，告别跨系统人工拼图&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="m365-sales-agent" value="&lt;b&gt;Microsoft 365 Sales Agent（一方对话前门）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;将简短业务黑话展开为复合推理计划，呈现附带证据链的决策建议&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="work-iq-context" value="&lt;b&gt;Work IQ：邮件、日历、聊天与会议转写纪要&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;开箱自动挂载个人工作上下文，无需额外自建数据搬运管道&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="dataverse-business-skills" value="&lt;b&gt;CRM 路：Business Skills（40+ 项）+ Dataverse MCP&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;注入 Vanguard 专属词汇表与业务规则，经 MCP 服务读写客户与商机&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="custom-sales-extension" value="&lt;b&gt;信号路：自定义扩展 + Microsoft Fabric IQ&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;桥接非微软生态外部数据湖，按线索分与时效拉取机构异动与推荐动作&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="fas360-data-lake" value="&lt;b&gt;FAS 360 多云数据湖与 Next Best Actions&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;沉淀资金净流向、线索评分与确定性下一步最佳行动，拒绝对客临场编造&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="identity-delegated-auth" value="&lt;b&gt;委托身份与最小权限（Identity &amp;amp; Authorization）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;智能体仅能访问当前人类用户有权查看的数据，绝不越权执行任何操作&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="confirm-before-write" value="&lt;b&gt;歧义暂停核实与写入前人工审批弹窗&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;遇重名客户或重复商机主动追问；外发邮件与 CRM 回写必须经人工确认&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="shared-dynamics-dataverse" value="&lt;b&gt;多业务线共享单实例 Dynamics 365 / Dataverse&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;同时尊重后端与界面展示层双层校验规则，保持 Vanguard 唯一事实源&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="e1" value="自然语言简问" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="fas-sales-exec" target="m365-sales-agent"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="自动注入上下文" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="work-iq-context" target="m365-sales-agent"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="拆解子提示词" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m365-sales-agent" target="dataverse-business-skills"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="查询机构信号" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m365-sales-agent" target="custom-sales-extension"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="线索分与 NBA" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="fas360-data-lake" target="custom-sales-extension"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="用户身份鉴权" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dataverse-business-skills" target="identity-delegated-auth"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="双路统一策略" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="custom-sales-extension" target="identity-delegated-auth"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="重名消歧与审批" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="identity-delegated-auth" target="confirm-before-write"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="受控回写记录" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="confirm-before-write" target="shared-dynamics-dataverse"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
