<mxfile host="Study-Room-Figure-Engine" version="2"><diagram id="page-1" name="Copilot 托管运行时三扇前门与单提示词四联交付架构（THR887）"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group-three-front-doors" value="1. 三扇前门，同一应用技能（Three Front Doors, One Underlying App Skill &amp; Git Repo）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FFF9F3;strokeColor=#DED2C3;fontColor=#7C2D12;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1440" height="190" as="geometry"/></mxCell><mxCell id="group-single-prompt-four-outputs" value="2. 单条提示词四联生成引擎（One Prompt -&gt; Four Enterprise Artifacts in Copilot Studio）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#F7FAFC;strokeColor=#CAD7E2;fontColor=#1E3A5F;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="238" width="1440" height="190" as="geometry"/></mxCell><mxCell id="group-cmr-governed-substrate" value="3. Copilot 托管运行时生产与治理底座（Hosted Infrastructure, Entra Identity &amp; M365 Admin）" style="swimlane;html=1;rounded=1;arcSize=10;horizontal=1;startSize=44;fillColor=#FAF8FC;strokeColor=#D8CEE5;fontColor=#4C1D95;fontSize=15;fontStyle=1;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="452" width="1440" height="190" as="geometry"/></mxCell><mxCell id="door-cowork" value="&lt;b&gt;Copilot Cowork：信息工作者前门&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;在日常协作流中直接调用邮件、文档与会议上下文（如追踪 350+ 客户经理回执）&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="door-studio" value="&lt;b&gt;Copilot Studio：业务流程与智能体前门&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;THR887 主场演示入口：在智能体与工作流旁构建基于真实业务数据的生产应用&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="door-cli-sdk" value="&lt;b&gt;命令行与开发套件：专业研发前门&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;完整掌控标准 React + TypeScript 代码仓与版本回滚，仍由微软托管运行&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9F7;strokeColor=#0D8F8C;strokeWidth=2;fontColor=#115E59;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="94" width="320" height="96" as="geometry"/></mxCell><mxCell id="artifact-app-agent" value="&lt;b&gt;01–02 交互式 Web 应用 + 内联智能体&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;通过新智能体节点连接器将 AI 深度织入界面（汇总 45 条动态并起草 GitHub 缺陷单）&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="artifact-dataverse" value="&lt;b&gt;03 Dataverse 插件自动建表持久化&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;免手工建模，按提示词自动创建社区反馈、反馈来源与产品领域 3 张结构化数据表&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="artifact-cowork-skill" value="&lt;b&gt;04 跨端复用技能产出 10 页用户手册&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;在 Copilot Studio 内直接唤醒 Cowork 技能，零人工编排生成完整应用说明文档&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="308" width="320" height="96" as="geometry"/></mxCell><mxCell id="cmr-sdk-connectors" value="&lt;b&gt;M365 桥接套件与 1,500+ 受管连接器&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;原生接通 Entra 登录、Work IQ 组织上下文、Office 365 用户识别与 GitHub 仓库&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="136" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="cmr-managed-host" value="&lt;b&gt;微软零服务器托管与统一应用门户&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;运行在租户专属微软托管基础设施，员工通过 managedapps.cloud.microsoft 访问&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="cmr-admin-policy" value="&lt;b&gt;创建首分钟即受控：M365 管理中心&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;自动继承防数据泄漏、共享与连接器分组策略，管理员全局透视全租户 159 款受管应用&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1064" y="522" width="320" height="96" as="geometry"/></mxCell><mxCell id="e1" value="共享 Git 源码" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="door-cowork" target="artifact-app-agent"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="单提示词触发" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="door-studio" target="artifact-app-agent"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="创建 3 张新表" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="door-studio" target="artifact-dataverse"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="跨端调技能" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="door-studio" target="artifact-cowork-skill"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="接力编辑与回滚" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="door-cli-sdk" target="artifact-app-agent"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="类型化连接器" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="artifact-app-agent" target="cmr-sdk-connectors"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="托管门户分发" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="artifact-dataverse" target="cmr-managed-host"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="随应用同步分享" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="artifact-cowork-skill" target="cmr-managed-host"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="自动校验策略组" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cmr-sdk-connectors" target="cmr-admin-policy"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
